---
import '@fontsource/marcellus';
import '@fontsource-variable/archivo';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';

import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { SITE } from '../config';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import defaultOgSource from '../assets/photos/PLACEHOLDER-orion-nebula.jpg';

interface Props {
  /** Page title — rendered as "<title> — Abdur Astro" (home page passes its own full title). */
  title: string;
  /** Unique per-page meta description. */
  description: string;
  /** Key image for OG / Twitter cards; falls back to the hero photograph. */
  ogImage?: ImageMetadata;
  ogImageAlt?: string;
  /** Extra JSON-LD blocks (e.g. Product on print pages). */
  schema?: Record<string, unknown>[];
  /** Let the header float over a full-bleed hero (home page). */
  overlayHeader?: boolean;
  /** Set on the home page so the title reads as the brand, not "Home — Abdur Astro". */
  isHome?: boolean;
}

const {
  title,
  description,
  ogImage,
  ogImageAlt,
  schema = [],
  overlayHeader = false,
  isHome = false,
} = Astro.props;

const fullTitle = isHome ? title : `${title} — ${SITE.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);

const og = await getImage({
  src: ogImage ?? defaultOgSource,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpeg',
  quality: 80,
});
const ogUrl = new URL(og.src, Astro.site);
const ogAlt = ogImageAlt ?? `${SITE.name} — deep-sky astrophotography`;

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': new URL('/#business', Astro.site).href,
  name: SITE.name,
  description:
    'Deep-sky astrophotography from Central Alberta, Canada — fine art prints, one-on-one astrophotography tutorials, equipment consulting, public speaking, and private star parties.',
  url: Astro.site?.href,
  email: SITE.email,
  image: ogUrl.href,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Central Alberta',
    addressRegion: 'AB',
    addressCountry: 'CA',
  },
  areaServed: ['Central Alberta', 'Alberta', 'Canada'],
  sameAs: [SITE.social.youtube, SITE.social.instagram, SITE.social.facebook],
  knowsAbout: [
    'Astrophotography',
    'Deep-sky imaging',
    'Fine art astronomy prints',
    'Astronomy education',
  ],
};

const jsonLd = [localBusiness, ...schema];
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0b0a09" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogUrl.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:locale" content="en_CA" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl.href} />
    <meta name="twitter:image:alt" content={ogAlt} />

    {jsonLd.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}

    <script is:inline>
      // Marks JS as available before first paint so reveal styles apply
      // only when the enhancement script will actually run them.
      if ('IntersectionObserver' in window) document.documentElement.classList.add('js');
    </script>
  </head>
  <body class="min-h-svh flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-surface focus:px-4 focus:py-2 font-mono text-[0.8125rem] uppercase tracking-widest"
    >
      Skip to content
    </a>
    <Header overlay={overlayHeader} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <script src="../scripts/enhance.ts"></script>
  </body>
</html>
