---
import SocialLinks from './SocialLinks.astro';

interface Props {
  /** Float transparently over a full-bleed hero (home) instead of sitting on the page. */
  overlay?: boolean;
}
const { overlay = false } = Astro.props;

const links = [
  { href: '/gallery', label: 'Gallery' },
  { href: '/services', label: 'Services' },
  { href: '/rentals', label: 'Rentals' },
  { href: '/events', label: 'Events' },
  { href: '/about', label: 'About' },
];

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header
  data-header
  data-overlay={overlay ? 'true' : 'false'}
  class:list={[
    'z-40 w-full transition-colors duration-300',
    overlay ? 'fixed inset-x-0 top-0' : 'sticky top-0 border-b hairline bg-sky',
  ]}
>
  {
    overlay && (
      <div
        data-header-scrim
        class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-b from-sky/85 via-sky/45 to-transparent transition-opacity duration-300"
        aria-hidden="true"
      />
    )
  }
  <div class="relative mx-auto flex w-full max-w-7xl items-center justify-between px-5 py-5 sm:px-8">
    <a href="/" class="group inline-flex items-center gap-3" aria-label="Abdur Astro, home">
      <svg
        width="20"
        height="20"
        viewBox="0 0 32 32"
        fill="none"
        aria-hidden="true"
        class="shrink-0"
      >
        <g stroke="currentColor" stroke-width="1.5">
          <circle cx="16" cy="16" r="8"></circle>
          <path d="M16 2v7M16 23v7M2 16h7M23 16h7"></path>
        </g>
        <circle cx="16" cy="16" r="2" fill="#a63a28"></circle>
      </svg>
      {/* Slightly tighter below sm: at full cap tracking the wordmark ate 169px
          of a 360px bar, leaving the Shop button nothing to sit in. */}
      <span
        class="font-display text-[0.8125rem] uppercase [letter-spacing:0.16em] sm:text-[0.9375rem] sm:[letter-spacing:var(--tracking-cap)]"
      >
        Abdur&nbsp;Astro
      </span>
    </a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-6">
        {
          links.map(({ href, label }) => (
            <li>
              <a
                href={href}
                aria-current={isCurrent(href) ? 'page' : undefined}
                class:list={[
                  'font-mono text-sm uppercase [letter-spacing:var(--tracking-log)] transition-colors duration-150',
                  isCurrent(href) ? 'text-star' : 'text-star/75 hover:text-star',
                ]}
              >
                {label}
                {isCurrent(href) && <span class="text-dust" aria-hidden="true">&nbsp;·</span>}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="hidden items-center gap-5 lg:flex">
      {/* Socials only once there is room for them; they are in the footer
          on every page and on the contact page regardless. */}
      <div class="hidden xl:block">
        <SocialLinks platforms={['youtube', 'instagram', 'x']} />
      </div>
      {/* A matched pair: equal width and weight, and closer to each other than
          to the socials, so they read as one set of actions. */}
      <div class="flex items-center gap-2.5">
        <a href="/services" class="btn btn-solid btn-sm w-[8.25rem]">Book consult</a>
        <a href="/prints" class="btn btn-solid btn-sm w-[8.25rem]">Shop prints</a>
      </div>
    </div>

    {/* Prints has no nav link (the desktop CTA stands in for it), and that CTA
        is desktop-only, so on mobile the shop needs its own visible entry in
        the bar rather than living one tap deep in the menu. */}
    <div class="flex shrink-0 items-center gap-2 lg:hidden">
      <a href="/prints" class="btn btn-solid btn-xs" aria-label="Shop prints">Shop</a>

      <details class="group">
      <summary
        class="flex cursor-pointer list-none items-center gap-2 font-mono text-sm uppercase [letter-spacing:var(--tracking-log)] text-star [&::-webkit-details-marker]:hidden"
      >
        <span class="group-open:hidden">Menu</span>
        <span class="hidden group-open:inline">Close</span>
        <svg width="18" height="14" viewBox="0 0 18 14" aria-hidden="true" class="group-open:hidden">
          <path d="M0 1h18M0 7h18M0 13h18" stroke="currentColor" stroke-width="1.5"></path>
        </svg>
        <svg
          width="14"
          height="14"
          viewBox="0 0 14 14"
          aria-hidden="true"
          class="hidden group-open:block"
        >
          <path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.5"></path>
        </svg>
      </summary>
      <nav
        aria-label="Main menu"
        class="absolute inset-x-0 top-full z-50 border-y hairline bg-sky px-5 py-6 sm:px-8"
      >
        <ul class="flex flex-col gap-5">
          {
            links.map(({ href, label }, i) => (
              <li>
                <a
                  href={href}
                  aria-current={isCurrent(href) ? 'page' : undefined}
                  class="flex items-baseline gap-4 text-star"
                >
                  <span class="font-mono text-[0.6875rem] text-dust">0{i + 1}</span>
                  <span class="font-display text-xl">{label}</span>
                </a>
              </li>
            ))
          }
        </ul>
        {/* The header CTAs are desktop-only, so without these the shop and the
            booking page had no entry point anywhere in the mobile header. */}
        <div class="mt-7 grid gap-3 border-t hairline pt-6">
          <a href="/services" class="btn btn-solid w-full">Book consult</a>
          <a href="/prints" class="btn btn-solid w-full">Shop prints</a>
        </div>
      </nav>
      </details>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header?.dataset.overlay === 'true') {
    const scrim = header.querySelector<HTMLElement>('[data-header-scrim]');
    const onScroll = () => {
      const scrolled = window.scrollY > 40;
      header.classList.toggle('bg-sky', scrolled);
      header.classList.toggle('border-b', scrolled);
      header.classList.toggle('hairline', scrolled);
      if (scrim) scrim.style.opacity = scrolled ? '0' : '1';
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
