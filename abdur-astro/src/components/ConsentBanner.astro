---
/**
 * Rendered whenever at least one tag is configured, and hidden until the
 * script confirms the visitor hasn't chosen yet, so a returning visitor never
 * sees it flash.
 * - opt-in: asks first; nothing loads until Allow.
 * - opt-out: the tags are already on, so this is the prominent notice at
 *   collection that Canadian law expects for implied consent, with a
 *   one-click way to turn them off.
 */
import { SITE } from '../config';

const t = SITE.tracking;
const usesMeta = Boolean(t.metaPixelId.trim());
const usesGoogle = Boolean(t.ga4Id.trim() || t.googleAdsId.trim());
const show = usesMeta || usesGoogle;
const optIn = t.consent === 'opt-in';
// Names only the tools that would actually load.
const names = [usesMeta && 'Meta', usesGoogle && 'Google'].filter(Boolean).join(' and ');
---

{
  show && (
    <div
      id="consent-banner"
      hidden
      role="region"
      aria-label="Measurement consent"
      class="fixed inset-x-3 bottom-3 z-50 mx-auto max-w-2xl border hairline bg-surface p-4 shadow-2xl sm:inset-x-6 sm:p-5"
    >
      <p class="text-sm text-star/85">
        {optIn
          ? `May this site use ${names} measurement to learn which ads lead to a sale? Nothing loads unless you allow it.`
          : `This site uses ${names} measurement to learn which ads lead to a sale.`}{' '}
        <a href="/privacy" class="link-quiet">Privacy</a>
      </p>
      <div class="mt-3 flex gap-2">
        <button type="button" data-consent="on" class="btn btn-solid btn-sm">
          {optIn ? 'Allow' : 'OK'}
        </button>
        <button type="button" data-consent="off" class="btn btn-sm">
          {optIn ? 'No thanks' : 'Turn it off'}
        </button>
      </div>
    </div>
  )
}

<script>
  import { setTrackingChoice, trackingChoice } from '../lib/track';

  const banner = document.getElementById('consent-banner');
  if (banner && navigator.globalPrivacyControl !== true && trackingChoice() === null) {
    // While the banner is up, keep focused fields and anchors from scrolling
    // underneath it: reserve its height at the bottom of the viewport.
    const pad = () => {
      document.documentElement.style.scrollPaddingBottom = banner.hidden
        ? ''
        : `${innerHeight - banner.getBoundingClientRect().top + 16}px`;
    };
    banner.hidden = false;
    pad();
    addEventListener('resize', pad);

    banner.querySelectorAll<HTMLButtonElement>('[data-consent]').forEach((button) => {
      button.addEventListener('click', () => {
        const choice = button.dataset.consent === 'on' ? 'on' : 'off';
        setTrackingChoice(choice);
        if (choice === 'on') window.aaLoadTracking?.();
        else window.aaStopTracking?.();
        // Focus would otherwise fall to <body> when the focused button
        // disappears; hand it to the page content instead.
        const main = document.getElementById('main');
        if (main && banner.contains(document.activeElement)) {
          main.setAttribute('tabindex', '-1');
          main.focus({ preventScroll: true });
        }
        banner.hidden = true;
        removeEventListener('resize', pad);
        pad();
      });
    });
  }
</script>
