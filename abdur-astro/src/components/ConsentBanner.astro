---
/**
 * Only rendered in `opt-in` consent mode with at least one tag configured.
 * Hidden until the script confirms the visitor hasn't chosen yet, so a
 * returning visitor never sees it flash.
 */
import { SITE } from '../config';

const t = SITE.tracking;
const show =
  t.consent === 'opt-in' && Boolean(t.metaPixelId.trim() || t.ga4Id.trim() || t.googleAdsId.trim());
---

{
  show && (
    <div
      id="consent-banner"
      hidden
      role="region"
      aria-label="Measurement consent"
      class="fixed inset-x-3 bottom-3 z-50 mx-auto max-w-2xl border hairline bg-surface p-4 shadow-2xl sm:inset-x-6 sm:p-5"
    >
      <p class="text-sm text-star/85">
        May this site use Meta and Google measurement to learn which ads lead to a sale? Nothing
        loads unless you allow it.{' '}
        <a href="/privacy" class="link-quiet">Privacy</a>
      </p>
      <div class="mt-3 flex gap-2">
        <button type="button" data-consent="on" class="btn btn-solid btn-sm">
          Allow
        </button>
        <button type="button" data-consent="off" class="btn btn-sm">
          No thanks
        </button>
      </div>
    </div>
  )
}

<script>
  import { setTrackingChoice, trackingChoice } from '../lib/track';

  const banner = document.getElementById('consent-banner');
  const gpc = (navigator as Navigator & { globalPrivacyControl?: boolean }).globalPrivacyControl === true;
  if (banner && !gpc && trackingChoice() === null) {
    banner.hidden = false;
    banner.querySelectorAll<HTMLButtonElement>('[data-consent]').forEach((button) => {
      button.addEventListener('click', () => {
        const choice = button.dataset.consent === 'on' ? 'on' : 'off';
        setTrackingChoice(choice);
        if (choice === 'on') (window as Window & { aaLoadTracking?: () => void }).aaLoadTracking?.();
        banner.hidden = true;
      });
    });
  }
</script>
