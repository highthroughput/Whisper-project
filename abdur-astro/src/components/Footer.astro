---
import { SITE } from '../config';
import SocialLinks from './SocialLinks.astro';

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t hairline">
  <div class="mx-auto w-full max-w-7xl px-5 py-12 sm:px-8">
    <div
      class="flex flex-col gap-2 font-mono text-[0.6875rem] uppercase [letter-spacing:var(--tracking-log)] text-faint sm:flex-row sm:items-baseline sm:justify-between"
    >
      <span>Abdur Astro — Field Station</span>
      <span>{SITE.coordinates} · Central Alberta · Bortle 2–4 skies</span>
    </div>

    <div class="mt-10 grid grid-cols-2 gap-10 sm:grid-cols-3">
      <nav aria-label="Footer — explore">
        <h2 class="eyebrow">Explore</h2>
        <ul class="mt-4 space-y-2.5 text-sm">
          <li><a class="text-faint hover:text-star transition-colors" href="/gallery">Gallery</a></li>
          <li><a class="text-faint hover:text-star transition-colors" href="/prints">Prints</a></li>
          <li>
            <a class="text-faint hover:text-star transition-colors" href="/services">Services</a>
          </li>
        </ul>
      </nav>
      <nav aria-label="Footer — studio">
        <h2 class="eyebrow">Studio</h2>
        <ul class="mt-4 space-y-2.5 text-sm">
          <li><a class="text-faint hover:text-star transition-colors" href="/about">About</a></li>
          <li>
            <a class="text-faint hover:text-star transition-colors" href="/contact">Contact</a>
          </li>
          <li>
            <a class="text-faint hover:text-star transition-colors" href={`mailto:${SITE.email}`}>
              {SITE.email}
            </a>
          </li>
        </ul>
      </nav>
      <div class="col-span-2 sm:col-span-1">
        <h2 class="eyebrow">Elsewhere</h2>
        <SocialLinks class="mt-4" />
      </div>
    </div>

    <div class="mt-12 border-t hairline pt-6 text-xs text-faint">
      <p>
        © {year} Abdur Astro · Deep-sky astrophotography, prints, tutorials &amp; star parties —
        Alberta, Canada.
      </p>
      <p class="mt-2 opacity-70">
        Development placeholder imagery: NASA/ESA Hubble (CC BY 4.0) — replace with original
        photographs before launch.
      </p>
    </div>
  </div>
</footer>
