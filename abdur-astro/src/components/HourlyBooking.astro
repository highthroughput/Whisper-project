---
interface Props {
  /** One Stripe Payment Link per hour, index 0 = 1 hour. */
  links: [string, string, string, string, string];
  ratePerHour: number;
  label?: string;
  class?: string;
}
const { links, ratePerHour, label = 'Book now', class: className } = Astro.props;
const options = links.map((url, i) => ({ hours: i + 1, price: (i + 1) * ratePerHour, url }));
---

<div class:list={['hourly-booking mt-6 border hairline bg-surface p-4 sm:p-5', className]}>
  <p class="mb-2 font-mono text-[0.6875rem] uppercase [letter-spacing:var(--tracking-log)] text-faint">
    Book by the hour · ${ratePerHour}/hr
  </p>
  <div class="flex gap-2">
    <label for={`hours-${label}`} class="sr-only">Number of hours</label>
    <select
      id={`hours-${label}`}
      class="hours-select select-log"
    >
      {
        options.map(({ hours, price }) => (
          <option value={hours}>
            {hours} hour{hours > 1 ? 's' : ''} · ${price}
          </option>
        ))
      }
    </select>
    <a
      href={links[0]}
      class="book-link btn btn-solid btn-sm grow"
      data-stripe-placeholder
      data-links={JSON.stringify(links)}
      aria-label={`${label}, select hours above first`}
    >
      {label} →
    </a>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.hourly-booking').forEach((widget) => {
    const select = widget.querySelector<HTMLSelectElement>('.hours-select');
    const link = widget.querySelector<HTMLAnchorElement>('.book-link');
    if (!select || !link) return;
    const links = JSON.parse(link.dataset.links ?? '[]') as string[];
    const update = () => {
      const url = links[Number(select.value) - 1];
      if (url) link.href = url;
    };
    select.addEventListener('change', update);
    update();
  });
</script>
