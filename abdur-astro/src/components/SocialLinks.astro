<ul class:list={['flex items-center gap-4', className]}>
  {
    socials.map(({ href, label, path }) => (
      <li>
        <a
          href={href}
          class="block p-1 text-faint transition-colors duration-150 hover:text-star"
          aria-label={`${label} (opens in a new tab)`}
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d={path} />
          </svg>
        </a>
      </li>
    ))
  }
</ul>
