---
/**
 * Loads the Meta Pixel and the Google tag in <head>, and only when an ID is
 * set in SITE.tracking. With every ID empty this renders nothing at all.
 *
 * Whether the tags load is decided in the browser, before either one runs:
 * - `opt-out` mode loads them unless the visitor turned measurement off on
 *   /privacy (stored as aa:tracking = "off");
 * - `opt-in` mode loads them only after the consent banner is accepted;
 * - a browser sending Global Privacy Control never loads them;
 * - a browser that blocks site storage never loads them either, since an
 *   opt-out couldn't be saved there.
 * Turning measurement off on /privacy also silences the tags already running
 * on that page (window.aaStopTracking), and a page restored from the
 * back/forward cache after an opt-out is reloaded so the gate runs again.
 */
import { SITE } from '../config';

const t = SITE.tracking;
const aaConfig = {
  metaPixelId: t.metaPixelId.trim(),
  ga4Id: t.ga4Id.trim(),
  adsId: t.googleAdsId.trim(),
  purchaseLabel: t.googleAdsPurchaseLabel.trim(),
  leadLabel: t.googleAdsLeadLabel.trim(),
  consent: t.consent,
};
const enabled = Boolean(aaConfig.metaPixelId || aaConfig.ga4Id || aaConfig.adsId);
---

{
  enabled && (
    <script is:inline define:vars={{ aaConfig }}>
      // Stripe returns to /thank-you with ?session_id=cs_…. Keep it for the
      // purchase event, but take it out of the address bar before either tag
      // reads the page URL, so it isn't copied into analytics page views.
      try {
        var url = new URL(window.location.href);
        var sid = url.searchParams.get('session_id');
        if (sid) {
          window.aaCheckoutSession = sid;
          url.searchParams.delete('session_id');
          history.replaceState(history.state, '', url.pathname + url.search + url.hash);
        }
      } catch (e) {}

      window.aaTrackingConsent = aaConfig.consent;

      window.aaLoadTracking = function () {
        window.aaTrackingOff = false;
        if (window.aaTrackingLoaded) {
          // Already on this page and switched off earlier: switch back on.
          if (window.fbq) window.fbq('consent', 'grant');
          if (aaConfig.ga4Id) window['ga-disable-' + aaConfig.ga4Id] = false;
          if (aaConfig.adsId) window['ga-disable-' + aaConfig.adsId] = false;
          return;
        }
        window.aaTrackingLoaded = true;

        if (aaConfig.adsId) {
          window.aaAds = {
            adsId: aaConfig.adsId,
            purchaseLabel: aaConfig.purchaseLabel,
            leadLabel: aaConfig.leadLabel,
          };
        }

        if (aaConfig.metaPixelId) {
          // Meta's base code, unchanged apart from formatting.
          !(function (f, b, e, v, n, t, s) {
            if (f.fbq) return;
            n = f.fbq = function () {
              n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
            };
            if (!f._fbq) f._fbq = n;
            n.push = n;
            n.loaded = !0;
            n.version = '2.0';
            n.queue = [];
            t = b.createElement(e);
            t.async = !0;
            t.src = v;
            s = b.getElementsByTagName(e)[0];
            s.parentNode.insertBefore(t, s);
          })(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
          // autoConfig off, before init: no automatic button-click events and
          // no automatic advanced matching, which reads email fields on the
          // page. Only the events this site sends explicitly go to Meta, which
          // is what /privacy promises.
          window.fbq('set', 'autoConfig', false, aaConfig.metaPixelId);
          window.fbq('init', aaConfig.metaPixelId);
          window.fbq('track', 'PageView');
        }

        var tagId = aaConfig.ga4Id || aaConfig.adsId;
        if (tagId) {
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () {
            window.dataLayer.push(arguments);
          };
          var g = document.createElement('script');
          g.async = true;
          g.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(tagId);
          document.head.appendChild(g);
          window.gtag('js', new Date());
          // Arriving back from Stripe's checkout would otherwise start a new
          // "checkout.stripe.com / referral" session in GA4 and take the
          // sale's credit from the ad or post that brought the buyer. The key
          // is only set when it applies: GA4 treats any value, false
          // included, as "ignore".
          var refHost = '';
          try {
            refHost = new URL(document.referrer).hostname;
          } catch (e) {}
          var gaConfig = /(^|\.)stripe\.com$/.test(refHost) ? { ignore_referrer: true } : {};
          if (aaConfig.ga4Id) window.gtag('config', aaConfig.ga4Id, gaConfig);
          if (aaConfig.adsId) window.gtag('config', aaConfig.adsId);
        }

        try {
          window.dispatchEvent(new Event('aa:tracking-loaded'));
        } catch (e) {}
      };

      // Turning measurement off mid-page: stop the site's own events and ask
      // both tags to stand down. Full unloading waits for the next page.
      window.aaStopTracking = function () {
        window.aaTrackingOff = true;
        if (window.fbq) window.fbq('consent', 'revoke');
        if (aaConfig.ga4Id) window['ga-disable-' + aaConfig.ga4Id] = true;
        if (aaConfig.adsId) window['ga-disable-' + aaConfig.adsId] = true;
      };

      var readAllowed = function () {
        var choice = null;
        var storageOk = true;
        try {
          choice = localStorage.getItem('aa:tracking');
        } catch (e) {
          storageOk = false;
        }
        window.aaStorageBlocked = !storageOk;
        var gpc = navigator.globalPrivacyControl === true;
        return (
          storageOk && !gpc && (aaConfig.consent === 'opt-in' ? choice === 'on' : choice !== 'off')
        );
      };

      // Registered before either tag's library loads, so it runs first: a
      // page brought back by the Back button after an opt-out is reloaded
      // (and the gate re-run) before the Pixel can send its restore PageView.
      addEventListener('pageshow', function (e) {
        if (!e.persisted || !window.aaTrackingLoaded || readAllowed()) return;
        e.stopImmediatePropagation();
        location.reload();
      });

      if (readAllowed()) window.aaLoadTracking();
    </script>
  )
}
