---
import { Image, getImage } from 'astro:assets';
import type { Photo } from '../lib/photos';
import { logLine } from '../lib/photos';

interface Props {
  photo: Photo;
  /** Wire the card up as a lightbox trigger (gallery page). */
  lightbox?: boolean;
  index?: number;
  /** Eager-load the first row of the grid. */
  eager?: boolean;
  class?: string;
}

const { photo, lightbox = false, index = 0, eager = false, class: className } = Astro.props;
const href = `/gallery/${photo.id}`;

// Pre-rendered large variants for the lightbox (JS swaps these in; without JS
// the card is a plain link to the detail page).
const lbImage = lightbox
  ? await getImage({ src: photo.data.image, width: 1800, format: 'webp', quality: 80 })
  : null;
---

<a
  href={href}
  class:list={['group block', className]}
  data-lightbox={lightbox ? '' : undefined}
  data-lb-index={lightbox ? index : undefined}
  data-lb-src={lbImage?.src}
  data-lb-alt={lightbox ? photo.data.alt : undefined}
  data-lb-title={lightbox ? photo.data.title : undefined}
  data-lb-log={lightbox ? logLine(photo) : undefined}
  data-lb-href={lightbox ? href : undefined}
>
  <div class="hover-lift overflow-hidden bg-surface">
    <Image
      src={photo.data.image}
      alt={photo.data.alt}
      widths={[420, 640, 960, 1280]}
      sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 92vw"
      class="aspect-[3/2] w-full object-cover"
      loading={eager ? 'eager' : 'lazy'}
      quality={75}
    />
  </div>
  {/* The arrow sits beside the title and appears on hover. Pinned to the far
      right of the row it read as an unrelated mark ~300px from what it annotates. */}
  <div class="mt-3 flex items-baseline gap-2">
    <h3 class="font-display text-lg leading-snug text-star group-hover:text-dust-bright transition-colors duration-200">
      {photo.data.title}
    </h3>
    <span
      class="hidden font-mono text-[0.6875rem] text-dust opacity-0 transition-opacity duration-200 group-hover:opacity-100 sm:inline"
      aria-hidden="true">↗</span
    >
  </div>
  <p class="mt-1 font-mono text-[0.6875rem] uppercase [letter-spacing:var(--tracking-log)] text-faint">
    {logLine(photo)}
  </p>
</a>
