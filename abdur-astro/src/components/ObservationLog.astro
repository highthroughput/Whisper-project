---
import type { Photo } from '../lib/photos';
import { filterColor, filterNames, formatHours, totalHours } from '../lib/photos';

interface Props {
  photo: Photo;
  /** Position in the archive, newest = highest. Rendered as "№ 07". */
  number?: number;
  class?: string;
}

const { photo, number, class: className } = Astro.props;
const { data } = photo;
const total = totalHours(data.filters);
---

<section
  class:list={['border hairline bg-surface font-mono text-[0.8125rem]', className]}
  aria-label={`Acquisition data for ${data.title}`}
>
  <header
    class="flex items-baseline justify-between gap-4 border-b hairline px-5 py-3 text-[0.6875rem] uppercase [letter-spacing:var(--tracking-log)]"
  >
    <h2 class="text-faint">Observation log</h2>
    {number !== undefined && <span class="text-dust">№ {String(number).padStart(2, '0')}</span>}
  </header>

  <dl class="px-5 py-4">
    {
      [
        ['Target', `${data.target}${data.designation ? ` · ${data.designation}` : ''}`],
        ['Constellation', data.constellation],
      ].map(([label, value]) => (
        <div class="flex items-baseline py-1.5">
          <dt class="shrink-0 text-[0.6875rem] uppercase [letter-spacing:var(--tracking-log)] text-faint">
            {label}
          </dt>
          <span class="log-leader" aria-hidden="true" />
          <dd class="text-right text-star">{value}</dd>
        </div>
      ))
    }
    <div class="flex items-baseline py-1.5">
      <dt
        class="shrink-0 text-[0.6875rem] uppercase [letter-spacing:var(--tracking-log)] text-faint"
      >
        Position
      </dt>
      <span class="log-leader" aria-hidden="true"></span>
      <dd class="text-right text-oiii">RA {data.ra} · Dec {data.dec}</dd>
    </div>

    <div class="my-3 border-t hairline" role="presentation"></div>

    {
      [
        ['Telescope', data.telescope],
        ['Camera', data.camera],
        ['Mount', data.mount],
        ['Filters', filterNames(data.filters)],
      ].map(([label, value]) => (
        <div class="flex items-baseline py-1.5">
          <dt class="shrink-0 text-[0.6875rem] uppercase [letter-spacing:var(--tracking-log)] text-faint">
            {label}
          </dt>
          <span class="log-leader" aria-hidden="true" />
          <dd class="text-right text-star">{value}</dd>
        </div>
      ))
    }

    <div class="my-3 border-t hairline" role="presentation"></div>

    <div class="py-1.5">
      <div class="flex items-baseline justify-between">
        <dt class="text-[0.6875rem] uppercase [letter-spacing:var(--tracking-log)] text-faint">
          Total integration
        </dt>
        <dd class="text-star">
          <span class="text-2xl font-medium tabular-nums">{formatHours(total)}</span>
          <span class="ml-1 text-[0.6875rem] uppercase [letter-spacing:var(--tracking-log)] text-faint"
            >hours</span
          >
        </dd>
      </div>

      {/* Proportional exposure per filter, in the colours the filters map to */}
      <div
        class="mt-3 flex h-1.5 w-full overflow-hidden"
        role="img"
        aria-label={`Exposure by filter: ${data.filters
          .map((f) => `${f.name} ${formatHours(f.hours)} hours`)
          .join(', ')}`}
      >
        {
          data.filters.map((f) => (
            <span
              class="h-full"
              style={`width:${(f.hours / total) * 100}%;background:${filterColor(f.name)}`}
            />
          ))
        }
      </div>
      <ul class="mt-2.5 flex flex-wrap gap-x-4 gap-y-1 text-[0.6875rem] text-faint" aria-hidden="true">
        {
          data.filters.map((f) => (
            <li class="flex items-center gap-1.5 whitespace-nowrap">
              <span
                class="inline-block h-1.5 w-1.5 rounded-full"
                style={`background:${filterColor(f.name)}`}
              />
              {f.name.toUpperCase()}
              <span class="tabular-nums">{formatHours(f.hours)}h</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="my-3 border-t hairline" role="presentation"></div>

    {
      [
        ['Captured', data.captured],
        ['Location', data.location],
      ].map(([label, value]) => (
        <div class="flex items-baseline py-1.5">
          <dt class="shrink-0 text-[0.6875rem] uppercase [letter-spacing:var(--tracking-log)] text-faint">
            {label}
          </dt>
          <span class="log-leader" aria-hidden="true" />
          <dd class="text-right text-star">{value}</dd>
        </div>
      ))
    }
  </dl>
</section>
