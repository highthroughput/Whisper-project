---
import { SITE } from '../config';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={['mt-6 max-w-md border hairline bg-surface p-4 sm:p-5', className]}>
  <p class="mb-1 font-mono text-[0.6875rem] uppercase [letter-spacing:var(--tracking-log)] text-faint">
    Free 15-minute consult call
  </p>
  <p class="text-sm text-star/85">
    A quick call to see if equipment consulting is the right fit. No cost, no commitment. Tell
    me a bit about what you're working on, then pick a time.
  </p>

  <form id="consult-lead-form" class="mt-4 space-y-3" action="https://api.web3forms.com/submit" method="POST">
    <input type="hidden" name="access_key" value={SITE.web3formsKey} />
    <input type="hidden" name="subject" value="Free consult call request · Abdur Astro" />
    <input type="hidden" name="from_name" value="Abdur Astro consult request" />
    {/* Web3Forms honeypot — hidden from people, filled by bots */}
    <input
      type="checkbox"
      name="botcheck"
      class="hidden"
      style="display:none"
      tabindex="-1"
      aria-hidden="true"
    />

    <div class="flex flex-col gap-1.5">
      <label for="consult-name" class="sr-only">Name</label>
      <input
        id="consult-name"
        name="name"
        type="text"
        required
        autocomplete="name"
        placeholder="Your name"
        class="w-full border hairline bg-sky px-3 py-2 text-sm text-star placeholder:text-faint/60"
      />
    </div>
    <div class="flex flex-col gap-1.5">
      <label for="consult-email" class="sr-only">Email</label>
      <input
        id="consult-email"
        name="email"
        type="email"
        required
        autocomplete="email"
        placeholder="you@example.com"
        class="w-full border hairline bg-sky px-3 py-2 text-sm text-star placeholder:text-faint/60"
      />
    </div>
    <div class="flex flex-col gap-1.5">
      <label for="consult-message" class="sr-only">What are you hoping to figure out?</label>
      <textarea
        id="consult-message"
        name="message"
        rows="2"
        placeholder="What are you hoping to figure out? (optional)"
        class="w-full border hairline bg-sky px-3 py-2 text-sm text-star placeholder:text-faint/60"
      ></textarea>
    </div>

    <div class="flex flex-wrap items-center gap-3 pt-1">
      <button type="submit" class="btn !px-4 !py-2 !text-xs">Send my details</button>
      <a
        href="GOOGLE_CALENDAR_BOOKING_LINK"
        class="btn btn-solid !px-4 !py-2 !text-xs"
        data-booking-placeholder
        target="_blank"
        rel="noopener noreferrer"
      >
        Book a time →
      </a>
    </div>
    <p id="consult-status" class="font-mono text-[0.6875rem] text-faint" role="status" aria-live="polite">
    </p>
  </form>
</div>

<script>
  const form = document.getElementById('consult-lead-form') as HTMLFormElement | null;

  if (form) {
    const status = document.getElementById('consult-status');

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (button) button.disabled = true;
      if (status) status.textContent = 'Sending…';

      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        const result = (await response.json()) as { success?: boolean; message?: string };
        if (response.ok && result.success) {
          form.reset();
          if (status) status.textContent = 'Got it. Now pick a time below.';
        } else {
          throw new Error(result.message ?? 'Submission failed');
        }
      } catch {
        if (status) status.textContent = 'Could not send just now. You can still book a time below.';
      } finally {
        if (button) button.disabled = false;
      }
    });
  }
</script>
