---
import { SITE } from '../config';

interface Props {
  /** Unique slug for this instance. Namespaces element ids and the radio group
      so two widgets can sit on the same page without colliding. */
  id: string;
  /** Lowercase service name, used in the email subject and the sheet. */
  service: string;
  /** Singular noun phrase for the copy, e.g. "a tutorial". Must read as a
      grammatical subject: "A quick call to see if <fitSubject> is the right fit." */
  fitSubject: string;
  /** Heading for the panel. */
  heading?: string;
  /** One Stripe Payment Link per hour, index 0 = 1 hour, for the paid session path. */
  hourlyLinks: [string, string, string, string, string];
  /** Google Calendar Appointment Schedule for the free 15-minute intro. */
  introCalendarLink: string;
  /** One Appointment Schedule per hour, index 0 = 1 hour, for the paid session path. */
  hourlyCalendarLinks: [string, string, string, string, string];
  ratePerHour: number;
  class?: string;
}
const {
  id,
  service,
  fitSubject,
  heading = 'Book a call',
  hourlyLinks,
  introCalendarLink,
  hourlyCalendarLinks,
  ratePerHour,
  class: className,
} = Astro.props;

const freeCopy = `A quick call to see if ${fitSubject} is the right fit. No cost, no commitment.`;
---

<div
  class:list={['consult-booking mt-6 border hairline bg-surface p-4 sm:p-5', className]}
  data-intro-calendar-link={introCalendarLink}
  data-hourly-calendar-links={JSON.stringify(hourlyCalendarLinks)}
  data-stripe-links={JSON.stringify(hourlyLinks)}
  data-service={service}
  data-free-copy={freeCopy}
>
  <p class="mb-1 font-mono text-[0.6875rem] uppercase [letter-spacing:var(--tracking-log)] text-faint">
    {heading}
  </p>
  <p class="text-sm text-star/85" data-mode-copy>{freeCopy}</p>

  {/* Segmented hairline chips rather than native radios: in a dark colour scheme
      an unchecked radio renders as a bright filled disc and a checked one as a
      thin ring, so the unselected option reads as the selected one. */}
  <fieldset class="js-only mt-4 grid grid-cols-2 items-stretch gap-2 border-0 p-0">
    <legend class="sr-only">Call type for {service}</legend>
    <div>
      <input
        type="radio"
        id={`${id}-call-type-free`}
        name={`${id}-call-type`}
        value="free"
        checked
        class="sr-only"
        data-call-type
      />
      <label for={`${id}-call-type-free`} class="chip">Free 15-min intro</label>
    </div>
    <div>
      <input
        type="radio"
        id={`${id}-call-type-paid`}
        name={`${id}-call-type`}
        value="paid"
        class="sr-only"
        data-call-type
      />
      <label for={`${id}-call-type-paid`} class="chip">Paid session</label>
    </div>
  </fieldset>

  <div data-paid-only class="js-only mt-3 hidden">
    <label for={`${id}-hours`} class="sr-only">Number of hours</label>
    <select id={`${id}-hours`} class="hours-select select-log w-full">
      {
        [1, 2, 3, 4, 5].map((h) => (
          <option value={h}>
            {h} hour{h > 1 ? 's' : ''} · ${h * ratePerHour}
          </option>
        ))
      }
    </select>
  </div>

  <form
    id={`${id}-lead-form`}
    data-lead-form
    aria-label={`Book ${service}`}
    class="js-only mt-4 space-y-3"
    action="https://api.web3forms.com/submit"
    method="POST"
  >
    <input type="hidden" name="access_key" value={SITE.web3formsKey} />
    <input type="hidden" name="subject" value={`Free ${service} intro call request · Abdur Astro`} />
    <input type="hidden" name="from_name" value="Abdur Astro booking request" />
    <input type="hidden" name="form" value={`${service} request`} />
    {/* Web3Forms honeypot — hidden from people, filled by bots */}
    <input
      type="checkbox"
      name="botcheck"
      class="hidden"
      style="display:none"
      tabindex="-1"
      aria-hidden="true"
    />

    <div class="flex flex-col gap-1.5">
      <label for={`${id}-name`} class="sr-only">Name</label>
      <input
        id={`${id}-name`}
        name="name"
        type="text"
        required
        autocomplete="name"
        placeholder="Your name"
        class="w-full border field-edge bg-sky px-3 py-2 text-sm text-star placeholder:text-faint"
      />
    </div>
    <div class="flex flex-col gap-1.5">
      <label for={`${id}-email`} class="sr-only">Email</label>
      <input
        id={`${id}-email`}
        name="email"
        type="email"
        required
        autocomplete="email"
        placeholder="you@example.com"
        class="w-full border field-edge bg-sky px-3 py-2 text-sm text-star placeholder:text-faint"
      />
    </div>
    <div class="flex flex-col gap-1.5">
      <label for={`${id}-message`} class="sr-only">What are you hoping to figure out?</label>
      <textarea
        id={`${id}-message`}
        name="message"
        rows="3"
        placeholder="What are you hoping to figure out? (optional)"
        class="w-full resize-y border field-edge bg-sky px-3 py-2 text-sm text-star placeholder:text-faint"
      ></textarea>
    </div>

    <button type="submit" class="btn btn-solid btn-sm w-full" data-submit-label>
      Book my free call →
    </button>
    <p
      data-status
      class="font-mono text-[0.6875rem] text-faint empty:hidden"
      role="status"
      aria-live="polite"
    >
    </p>
    <a data-fallback-link href="#" class="link-quiet hidden font-mono text-[0.6875rem]" target="_blank" rel="noopener noreferrer">
      Open the booking calendar →
    </a>
  </form>

  {/* The script is what opens the calendar and hands off to payment, so without
      it the form would take someone's details and tell them they had booked a
      call that was never scheduled. Send them straight to the calendar instead,
      which needs no JavaScript of ours. */}
  <noscript>
    <p class="mt-3 text-sm text-star/85">
      Booking needs JavaScript. You can still{' '}
      <a href={introCalendarLink} target="_blank" rel="noopener noreferrer" class="link-quiet">
        pick a time for a free 15-minute intro
      </a>{' '}
      or email{' '}
      <a href={`mailto:${SITE.email}`} class="link-quiet">{SITE.email}</a> to arrange a paid
      session.
    </p>
  </noscript>
</div>

<script>
  import { logToLeadSheet } from '../lib/leadSheet';

  document.querySelectorAll<HTMLElement>('.consult-booking').forEach((root) => {
    const introCalendarLink = root.dataset.introCalendarLink ?? '';
    const hourlyCalendarLinks = JSON.parse(root.dataset.hourlyCalendarLinks ?? '[]') as string[];
    const stripeLinks = JSON.parse(root.dataset.stripeLinks ?? '[]') as string[];
    const service = root.dataset.service ?? 'this service';
    const freeCopy = root.dataset.freeCopy ?? '';

    const form = root.querySelector<HTMLFormElement>('[data-lead-form]');
    const radios = root.querySelectorAll<HTMLInputElement>('[data-call-type]');
    const paidOnly = root.querySelector<HTMLElement>('[data-paid-only]');
    const hoursSelect = root.querySelector<HTMLSelectElement>('.hours-select');
    const modeCopy = root.querySelector<HTMLElement>('[data-mode-copy]');
    const submitLabel = root.querySelector<HTMLElement>('[data-submit-label]');
    const status = root.querySelector<HTMLElement>('[data-status]');
    const fallbackLink = root.querySelector<HTMLAnchorElement>('[data-fallback-link]');
    const subjectInput = form?.querySelector<HTMLInputElement>('input[name="subject"]');
    const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (!form || !submitButton) return;

    const currentMode = () => [...radios].find((r) => r.checked)?.value ?? 'free';

    const updateUI = () => {
      const isPaid = currentMode() === 'paid';
      const hours = Number(hoursSelect?.value ?? 1);
      paidOnly?.classList.toggle('hidden', !isPaid);
      if (modeCopy) {
        modeCopy.textContent = isPaid
          ? 'Pick how long you need, book a time, then pay for your session.'
          : freeCopy;
      }
      if (submitLabel) {
        submitLabel.textContent = isPaid
          ? `Book & pay for ${hours} hour${hours > 1 ? 's' : ''} →`
          : 'Book my free call →';
      }
    };

    radios.forEach((radio) => radio.addEventListener('change', updateUI));
    hoursSelect?.addEventListener('change', updateUI);
    updateUI();

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      const isPaid = currentMode() === 'paid';
      const hours = Number(hoursSelect?.value ?? 1);
      const calendarLink = isPaid ? hourlyCalendarLinks[hours - 1] : introCalendarLink;
      if (!calendarLink) {
        if (status)
          status.textContent = 'Booking link is missing for this option. Please email instead.';
        return;
      }

      if (subjectInput) {
        subjectInput.value = isPaid
          ? `Paid ${service} session request (${hours}h) · Abdur Astro`
          : `Free ${service} intro call request · Abdur Astro`;
      }

      // Opened synchronously, in the same click gesture as the submit, so
      // browsers don't treat it as a blocked popup. 'noopener' is left out of
      // the feature string because it forces a null return, which would make a
      // blocked popup indistinguishable from a successful one; opener is
      // severed by hand instead.
      const bookingTab = window.open(calendarLink, '_blank');
      if (bookingTab) {
        try {
          bookingTab.opener = null;
        } catch {
          /* cross-origin, already isolated */
        }
      }

      submitButton.disabled = true;
      if (status) status.textContent = isPaid ? 'Booking your slot…' : 'Sending…';

      const formData = new FormData(form);
      logToLeadSheet(form);

      fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: formData,
      })
        .catch(() => {})
        .finally(() => {
          // Never send someone to pay for a session they have not booked.
          if (!bookingTab) {
            submitButton.disabled = false;
            if (fallbackLink) {
              fallbackLink.href = calendarLink;
              fallbackLink.classList.remove('hidden');
            }
            if (status) {
              status.textContent = isPaid
                ? 'Your details are in, but the booking tab was blocked. Pick a time first, then we will take payment.'
                : 'Your details are in, but the booking tab was blocked. Pick a time below.';
            }
            return;
          }
          if (isPaid) {
            const stripeUrl = stripeLinks[hours - 1];
            if (stripeUrl) {
              window.location.href = stripeUrl;
            } else if (status) {
              submitButton.disabled = false;
              status.textContent =
                'Your details are in, but the payment link is missing. Please email to arrange payment.';
            }
            return;
          }
          form.reset();
          updateUI();
          submitButton.disabled = false;
          if (status) status.textContent = "Got it. We'll see you on the call.";
        });
    });
  });
</script>
