---
import { SITE } from '../config';

interface Props {
  /** One Stripe Payment Link per hour, index 0 = 1 hour, for the paid session path. */
  hourlyLinks: [string, string, string, string, string];
  /** Google Calendar Appointment Schedule for the free 15-minute intro. */
  introCalendarLink: string;
  /** One Appointment Schedule per hour, index 0 = 1 hour, for the paid session path. */
  hourlyCalendarLinks: [string, string, string, string, string];
  ratePerHour: number;
  class?: string;
}
const { hourlyLinks, introCalendarLink, hourlyCalendarLinks, ratePerHour, class: className } =
  Astro.props;
---

<div
  class:list={['consult-booking mt-6 border hairline bg-surface p-4 sm:p-5', className]}
  data-intro-calendar-link={introCalendarLink}
  data-hourly-calendar-links={JSON.stringify(hourlyCalendarLinks)}
  data-stripe-links={JSON.stringify(hourlyLinks)}
>
  <p class="mb-1 font-mono text-[0.6875rem] uppercase [letter-spacing:var(--tracking-log)] text-faint">
    Book a call
  </p>
  <p class="text-sm text-star/85" data-mode-copy>
    A quick call to see if equipment consulting is the right fit. No cost, no commitment.
  </p>

  {/* Segmented hairline chips rather than native radios: in a dark colour scheme
      an unchecked radio renders as a bright filled disc and a checked one as a
      thin ring, so the unselected option reads as the selected one. */}
  <fieldset class="mt-4 grid grid-cols-2 gap-2 border-0 p-0">
    <legend class="sr-only">Call type</legend>
    <div>
      <input type="radio" id="call-type-free" name="call-type" value="free" checked class="sr-only" />
      <label for="call-type-free" class="chip text-center">Free 15-min intro</label>
    </div>
    <div>
      <input type="radio" id="call-type-paid" name="call-type" value="paid" class="sr-only" />
      <label for="call-type-paid" class="chip text-center">Paid · ${ratePerHour}/hr</label>
    </div>
  </fieldset>

  <div data-paid-only class="mt-3 hidden">
    <label for="consult-hours" class="sr-only">Number of hours</label>
    <select
      id="consult-hours"
      class="hours-select select-log w-full"
    >
      {
        [1, 2, 3, 4, 5].map((h) => (
          <option value={h}>
            {h} hour{h > 1 ? 's' : ''} · ${h * ratePerHour}
          </option>
        ))
      }
    </select>
  </div>

  <form
    id="consult-lead-form"
    class="mt-4 space-y-3"
    action="https://api.web3forms.com/submit"
    method="POST"
  >
    <input type="hidden" name="access_key" value={SITE.web3formsKey} />
    <input type="hidden" name="subject" value="Free consult call request · Abdur Astro" />
    <input type="hidden" name="from_name" value="Abdur Astro consult request" />
    <input type="hidden" name="form" value="Consult request" />
    {/* Web3Forms honeypot — hidden from people, filled by bots */}
    <input
      type="checkbox"
      name="botcheck"
      class="hidden"
      style="display:none"
      tabindex="-1"
      aria-hidden="true"
    />

    <div class="flex flex-col gap-1.5">
      <label for="consult-name" class="sr-only">Name</label>
      <input
        id="consult-name"
        name="name"
        type="text"
        required
        autocomplete="name"
        placeholder="Your name"
        class="w-full border field-edge bg-sky px-3 py-2 text-sm text-star placeholder:text-faint"
      />
    </div>
    <div class="flex flex-col gap-1.5">
      <label for="consult-email" class="sr-only">Email</label>
      <input
        id="consult-email"
        name="email"
        type="email"
        required
        autocomplete="email"
        placeholder="you@example.com"
        class="w-full border field-edge bg-sky px-3 py-2 text-sm text-star placeholder:text-faint"
      />
    </div>
    <div class="flex flex-col gap-1.5">
      <label for="consult-message" class="sr-only">What are you hoping to figure out?</label>
      <textarea
        id="consult-message"
        name="message"
        rows="3"
        placeholder="What are you hoping to figure out? (optional)"
        class="w-full resize-y border field-edge bg-sky px-3 py-2 text-sm text-star placeholder:text-faint"
      ></textarea>
    </div>

    <button type="submit" class="btn btn-solid btn-sm w-full" data-submit-label>
      Book my free call →
    </button>
    <p
      id="consult-status"
      class="font-mono text-[0.6875rem] text-faint empty:hidden"
      role="status"
      aria-live="polite"
    >
    </p>
  </form>
</div>

<script>
  import { logToLeadSheet } from '../lib/leadSheet';

  document.querySelectorAll<HTMLElement>('.consult-booking').forEach((root) => {
    const introCalendarLink = root.dataset.introCalendarLink ?? '';
    const hourlyCalendarLinks = JSON.parse(root.dataset.hourlyCalendarLinks ?? '[]') as string[];
    const stripeLinks = JSON.parse(root.dataset.stripeLinks ?? '[]') as string[];

    const form = root.querySelector<HTMLFormElement>('#consult-lead-form');
    const radios = root.querySelectorAll<HTMLInputElement>('input[name="call-type"]');
    const paidOnly = root.querySelector<HTMLElement>('[data-paid-only]');
    const hoursSelect = root.querySelector<HTMLSelectElement>('.hours-select');
    const modeCopy = root.querySelector<HTMLElement>('[data-mode-copy]');
    const submitLabel = root.querySelector<HTMLElement>('[data-submit-label]');
    const status = root.querySelector<HTMLElement>('#consult-status');
    const subjectInput = form?.querySelector<HTMLInputElement>('input[name="subject"]');
    const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (!form || !submitButton) return;

    const currentMode = () => [...radios].find((r) => r.checked)?.value ?? 'free';

    const updateUI = () => {
      const isPaid = currentMode() === 'paid';
      const hours = Number(hoursSelect?.value ?? 1);
      paidOnly?.classList.toggle('hidden', !isPaid);
      if (modeCopy) {
        modeCopy.textContent = isPaid
          ? 'Book a time, then pay for your session by the hour.'
          : 'A quick call to see if equipment consulting is the right fit. No cost, no commitment.';
      }
      if (submitLabel) {
        submitLabel.textContent = isPaid
          ? `Book & pay for ${hours} hour${hours > 1 ? 's' : ''} →`
          : 'Book my free call →';
      }
    };

    radios.forEach((radio) => radio.addEventListener('change', updateUI));
    hoursSelect?.addEventListener('change', updateUI);
    updateUI();

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      const isPaid = currentMode() === 'paid';
      const hours = Number(hoursSelect?.value ?? 1);
      const calendarLink = isPaid ? hourlyCalendarLinks[hours - 1] : introCalendarLink;
      if (!calendarLink) {
        if (status) status.textContent = 'Booking link is missing for this option. Please email instead.';
        return;
      }

      if (subjectInput) {
        subjectInput.value = isPaid
          ? `Paid consulting session request (${hours}h) · Abdur Astro`
          : 'Free consult call request · Abdur Astro';
      }

      // Open the booking calendar synchronously, in the same click gesture as the
      // submit, so browsers don't treat it as a blocked popup.
      window.open(calendarLink, '_blank', 'noopener,noreferrer');

      submitButton.disabled = true;
      if (status) status.textContent = isPaid ? 'Booking your slot…' : 'Sending…';

      const formData = new FormData(form);
      logToLeadSheet(form);

      fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: formData,
      })
        .catch(() => {})
        .finally(() => {
          if (isPaid) {
            const stripeUrl = stripeLinks[hours - 1];
            if (stripeUrl) {
              window.location.href = stripeUrl;
            } else if (status) {
              submitButton.disabled = false;
              status.textContent = 'Your details are in, but the payment link is missing. Please email to arrange payment.';
            }
            return;
          }
          form.reset();
          updateUI();
          submitButton.disabled = false;
          if (status) status.textContent = "Got it. We'll see you on the call.";
        });
    });
  });
</script>
