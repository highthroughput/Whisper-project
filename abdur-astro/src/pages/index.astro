---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PhotoCard from '../components/PhotoCard.astro';
import { byDateDesc } from '../lib/photos';
import heroImage from '../assets/photos/PLACEHOLDER-orion-nebula.jpg';

const photos = (await getCollection('photos')).sort(byDateDesc);
const heroPhoto = photos.find((p) => p.id === 'orion-nebula');
const featured = photos.filter((p) => p.data.featured && p.id !== 'orion-nebula').slice(0, 3);

const entries = [
  {
    n: '01',
    href: '/gallery',
    title: 'Gallery',
    text: 'The archive — galaxies and nebulae gathered over hundreds of hours of Alberta darkness.',
  },
  {
    n: '02',
    href: '/prints',
    title: 'Prints',
    text: 'Fine art giclée prints made from the original masters, shipped across Canada.',
  },
  {
    n: '03',
    href: '/services',
    title: 'Services',
    text: 'Tutorials, equipment consulting, talks, and private star parties under dark prairie skies.',
  },
];
---

<Base
  isHome
  overlayHeader
  title="Abdur Astro — Deep-Sky Astrophotography from Central Alberta"
  description="Deep-sky astrophotography from the dark skies of Central Alberta — fine art galaxy and nebula prints, one-on-one astrophotography tutorials, equipment consulting, and private star parties across Alberta, Canada."
  ogImage={heroImage}
  ogImageAlt={heroPhoto?.data.alt}
>
  {/* Full-bleed hero — the photograph is the design */}
  <section class="relative flex min-h-svh items-end">
    <Image
      src={heroImage}
      alt={heroPhoto?.data.alt ??
        'The Orion Nebula: a vast cavern of glowing hydrogen with a brilliant white core.'}
      widths={[640, 960, 1440, 1920, 2200]}
      sizes="100vw"
      quality={72}
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 h-full w-full object-cover"
    />
    {/* Legibility scrim only — no decoration */}
    <div
      class="absolute inset-0 bg-gradient-to-t from-sky via-sky/30 to-sky/10"
      aria-hidden="true"
    >
    </div>

    <div class="relative mx-auto w-full max-w-7xl px-5 pb-16 pt-40 sm:px-8 sm:pb-20">
      <p class="eyebrow">Field station · 52.3° N · Central Alberta, Canada</p>
      <h1
        class="mt-4 font-display uppercase leading-[1.05] [letter-spacing:0.14em] text-star text-[clamp(2.4rem,7.5vw,5.25rem)]"
      >
        Abdur&nbsp;Astro
      </h1>
      <p class="mt-5 max-w-xl text-lg text-star/85">
        Deep-sky astrophotography from the dark skies of Central&nbsp;Alberta.
      </p>
      {
        heroPhoto && (
          <p class="mt-8 font-mono text-[0.6875rem] uppercase [letter-spacing:0.08em] text-star/60">
            In frame — {heroPhoto.data.target} {heroPhoto.data.title} · {heroPhoto.data.captured}
          </p>
        )
      }
    </div>
  </section>

  {/* Three entry points */}
  <section class="mx-auto w-full max-w-7xl px-5 sm:px-8" aria-label="Explore the site">
    <ul>
      {
        entries.map(({ n, href, title, text }) => (
          <li class="reveal border-b hairline first:border-t">
            <a
              href={href}
              class="group grid grid-cols-[auto_1fr] items-baseline gap-x-6 gap-y-2 py-9 sm:grid-cols-[3.5rem_14rem_1fr_auto] sm:gap-x-8"
            >
              <span class="font-mono text-[0.6875rem] text-dust">{n}</span>
              <h2 class="font-display text-3xl text-star transition-colors duration-200 group-hover:text-dust-bright sm:text-4xl">
                {title}
              </h2>
              <p class="col-span-2 max-w-md text-sm text-faint sm:col-span-1">{text}</p>
              <span
                class="hidden font-mono text-sm text-faint transition-all duration-200 group-hover:translate-x-1 group-hover:text-dust-bright sm:block"
                aria-hidden="true"
              >
                →
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {/* Featured observations */}
  <section class="mx-auto mt-24 w-full max-w-7xl px-5 sm:px-8" aria-labelledby="featured-heading">
    <div class="reveal flex items-baseline justify-between gap-4">
      <div>
        <p class="eyebrow">From the archive</p>
        <h2 id="featured-heading" class="mt-3 font-display text-3xl sm:text-4xl">
          Recent observations
        </h2>
      </div>
      <a href="/gallery" class="link-quiet font-mono text-xs uppercase [letter-spacing:var(--tracking-log)]">
        Full archive →
      </a>
    </div>
    <div class="mt-10 grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
      {
        featured.map((photo, i) => (
          <div class="reveal" style={`--reveal-delay:${i * 90}ms`}>
            <PhotoCard photo={photo} />
          </div>
        ))
      }
    </div>
  </section>

  {/* Services teaser */}
  <section class="mx-auto mt-28 w-full max-w-7xl px-5 sm:px-8" aria-labelledby="teaser-heading">
    <div class="reveal grid gap-10 border-t hairline pt-14 lg:grid-cols-2">
      <h2 id="teaser-heading" class="font-display text-3xl leading-snug sm:text-4xl">
        The dark sky is the resource.<br />Learning to use it is the craft.
      </h2>
      <div class="max-w-lg">
        <p class="text-faint">
          Beyond the archive: one-on-one astrophotography tutorials online or in person,
          equipment consulting for observers and businesses, public speaking for astronomy
          events, and private star parties in and around Central Alberta.
        </p>
        <div class="mt-7 flex flex-wrap gap-4">
          <a href="/services" class="btn">View services</a>
          <a href="/contact" class="btn btn-solid">Get in touch</a>
        </div>
      </div>
    </div>
  </section>
</Base>
