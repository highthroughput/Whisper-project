---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PhotoCard from '../components/PhotoCard.astro';
import Testimonials from '../components/Testimonials.astro';
import { byDateDesc } from '../lib/photos';
import heroImage from '../assets/photos/andromeda-galaxy.jpg';

const photos = (await getCollection('photos')).sort(byDateDesc);
const heroPhoto = photos.find((p) => p.id === 'andromeda-galaxy');
const featured = photos.filter((p) => p.data.featured && p.id !== 'andromeda-galaxy').slice(0, 3);

const entries = [
  {
    n: '01',
    href: '/gallery',
    title: 'Gallery',
    text: 'The archive: galaxies and nebulae gathered over hundreds of hours of Alberta darkness.',
  },
  {
    n: '02',
    href: '/prints',
    title: 'Prints',
    text: 'Fine art giclée prints made from the original masters, shipped across North America.',
  },
  {
    n: '03',
    href: '/services',
    title: 'Services',
    text: 'Tutorials, equipment consulting, talks, and private star parties under dark prairie skies.',
  },
  {
    n: '04',
    href: '/rentals',
    title: 'Rentals',
    text: 'Try a telescope before you buy one: a Sky-Watcher 10″ Dobsonian, by the night, weekend, or week.',
  },
  {
    n: '05',
    href: '/events',
    title: 'Events',
    text: 'Star parties near Southern Alberta, plus meteor showers and other sky events worth planning around.',
  },
];
---

<Base
  isHome
  overlayHeader
  title="Abdur Astro · Deep-Sky Astrophotography from Southern Alberta"
  description="Deep-sky astrophotography from the dark skies of Southern Alberta: fine art galaxy and nebula prints, one-on-one astrophotography tutorials, equipment consulting, and private star parties across Alberta, Canada."
  ogImage={heroImage}
  ogImageAlt={heroPhoto?.data.alt}
>
  {/* Full-bleed hero — the photograph is the design */}
  <section class="relative flex min-h-svh items-end">
    <Image
      src={heroImage}
      alt={heroPhoto?.data.alt ??
        'The Andromeda Galaxy, a vast spiral galaxy spanning the frame in soft blue-white light.'}
      widths={[640, 960, 1440, 1920, 2200]}
      sizes="100vw"
      quality={80}
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 h-full w-full object-cover"
    />
    {/* Legibility scrim, confined to the bottom text band so the rest of the photo shows at full brightness */}
    <div
      class="absolute inset-x-0 bottom-0 h-[58%] bg-gradient-to-t from-sky via-sky/72 to-transparent"
      aria-hidden="true"
    >
    </div>

    <div class="on-photo relative mx-auto w-full max-w-7xl px-5 pb-16 pt-40 sm:px-8 sm:pb-20">
      <h1
        class="font-display uppercase leading-[1.05] [letter-spacing:0.14em] text-star text-[clamp(2.4rem,8vw,6.5rem)]"
      >
        Abdur&nbsp;Astro
      </h1>
      <p class="mt-5 max-w-xl text-lg text-star">
        Deep-sky astrophotography from the dark skies of Southern&nbsp;Alberta
      </p>
      {/* The two metadata lines sit on local scrims, sized to the text: small type
          on the galaxy's own dust lane needs its own footing, and a page-wide
          gradient dark enough to carry it would cost the photograph its brightness.
          A flex column keeps each plate on its own line: as bare inline-blocks
          they would sit side by side wherever the viewport had room. */}
      <div class="mt-8 flex flex-col items-start gap-2">
        {
          heroPhoto && (
            <p class="bg-sky/75 px-2.5 py-1 font-mono text-[0.6875rem] uppercase [letter-spacing:var(--tracking-log)] text-star backdrop-blur-sm">
              In frame: {heroPhoto.data.target} {heroPhoto.data.title}
              {heroPhoto.data.captured && ` · ${heroPhoto.data.captured}`}
            </p>
          )
        }
        <p class="eyebrow bg-sky/75 px-2.5 py-1 text-dust-bright backdrop-blur-sm">
          Field station · 51.0° N · Southern Alberta, Canada
        </p>
      </div>
    </div>
  </section>

  {/* Five entry points */}
  <section class="mx-auto mt-16 w-full max-w-7xl px-5 sm:mt-20 sm:px-8" aria-label="Explore the site">
    <ul>
      {
        entries.map(({ n, href, title, text }) => (
          <li class="reveal border-b hairline first:border-t">
            <a
              href={href}
              class="group grid grid-cols-[auto_1fr] items-baseline gap-x-6 gap-y-2 py-9 sm:grid-cols-[3.5rem_16rem_auto_minmax(0,1fr)] sm:gap-x-8"
            >
              <span class="font-mono text-[0.6875rem] text-dust">{n}</span>
              <h2 class="font-display text-3xl text-star transition-colors duration-200 group-hover:text-dust-bright sm:text-4xl">
                {title}
              </h2>
              {/* col-start-2 on mobile so the description aligns under the title
                  rather than under the row number, which left a two-step rag. */}
              <p class="col-start-2 max-w-md text-sm text-faint sm:col-start-3">{text}</p>
              {/* A dotted leader carries the eye to the arrow. Pinned to the far
                  right on its own, the arrow floated ~300px clear of the row. */}
              <span class="hidden items-baseline sm:flex" aria-hidden="true">
                <span class="log-leader" />
                <span class="font-mono text-sm text-faint transition-all duration-200 group-hover:translate-x-1 group-hover:text-dust-bright">
                  →
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {/* Featured observations */}
  <section class="mx-auto mt-24 w-full max-w-7xl px-5 sm:px-8" aria-labelledby="featured-heading">
    {/* items-end puts the link on the h2's baseline instead of the eyebrow's,
        and the header stacks at phone width rather than squeezing both sides. */}
    <div class="reveal flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="eyebrow">From the archive</p>
        <h2 id="featured-heading" class="mt-3 font-display text-3xl sm:text-4xl">
          Recent images
        </h2>
      </div>
      <a
        href="/gallery"
        class="link-quiet whitespace-nowrap font-mono text-xs uppercase [letter-spacing:var(--tracking-log)]"
      >
        Full archive →
      </a>
    </div>
    <div class="mt-10 grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
      {
        featured.map((photo, i) => (
          <div class="reveal" style={`--reveal-delay:${i * 90}ms`}>
            <PhotoCard photo={photo} />
          </div>
        ))
      }
    </div>
  </section>

  {/* Testimonials */}
  <Testimonials limit={6} class="mx-auto mt-24 w-full max-w-7xl px-5 sm:px-8" />

  {/* Services teaser */}
  <section class="mx-auto mt-24 w-full max-w-7xl px-5 sm:px-8" aria-labelledby="teaser-heading">
    <div class="reveal grid gap-10 border-t hairline pt-12 lg:grid-cols-2">
      {/* Its own size tier: at text-4xl this closing statement was identical to
          the two list headings above it. The break is desktop-only, since at
          phone width it forced a four-line rag with one word on the last line. */}
      <h2 id="teaser-heading" class="font-display text-4xl leading-snug sm:text-5xl lg:text-[3.25rem]">
        The dark sky is the resource.{' '}
        <br class="hidden sm:inline" />Learning to use it is the craft.
      </h2>
      <div class="max-w-lg">
        <p class="text-faint">
          Beyond the archive: one-on-one astrophotography tutorials online or in person,
          equipment consulting and rentals for observers and businesses, public speaking for
          astronomy events, and private star parties in and around Southern Alberta.
        </p>
        <div class="mt-7 grid grid-cols-1 gap-3 sm:flex sm:flex-wrap sm:gap-4">
          <a href="/services" class="btn w-full sm:w-auto">View services</a>
          <a href="/contact" class="btn btn-solid w-full sm:w-auto">Get in touch</a>
        </div>
      </div>
    </div>
  </section>
</Base>
