---
import Base from '../layouts/Base.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { INQUIRY_TOPICS, SITE } from '../config';
---

<Base
  title="Book a Tutorial or Star Party"
  description="Get in touch about fine art astrophotography prints, one-on-one tutorials, equipment consulting, public speaking, or a private star party in Southern Alberta, Canada."
>
  <section class="mx-auto w-full max-w-7xl px-5 pt-14 sm:px-8 sm:pt-20">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:content-start lg:gap-20">
      <div>
        <p class="eyebrow">Signal check</p>
        <h1 class="mt-3 font-display text-4xl sm:text-5xl">Contact</h1>
        <p class="mt-6 max-w-md text-faint">
          Prints, tutorials, gear questions, a talk for your event, or a star party under
          Southern Alberta's dark skies: send a couple of lines and you'll hear back within
          two days, weather permitting.
        </p>

      </div>

      {/* Web3Forms — plain POST without JS; enhanced to inline fetch with JS */}
      <form
        id="contact-form"
        action="https://api.web3forms.com/submit"
        method="POST"
        class="border hairline bg-surface p-6 sm:p-8 lg:col-start-2 lg:row-span-2 lg:row-start-1"
      >
        <h2 class="font-mono text-[0.6875rem] uppercase [letter-spacing:var(--tracking-log)] text-faint">
          Transmission form
        </h2>

        <input type="hidden" name="access_key" value={SITE.web3formsKey} />
        <input type="hidden" name="from_name" value="abdurastro.com contact form" />
        <input type="hidden" name="subject" value="New inquiry · Abdur Astro" />
        <input type="hidden" name="form" value="Contact page" />
        {/* Web3Forms honeypot — hidden from people, filled by bots */}
        <input
          type="checkbox"
          name="botcheck"
          class="hidden"
          style="display:none"
          tabindex="-1"
          aria-hidden="true"
        />

        <div class="mt-6 grid gap-6 sm:grid-cols-2">
          <div class="flex flex-col gap-2">
            <label for="name" class="eyebrow text-faint">
              Name
            </label>
            <input
              id="name"
              name="name"
              type="text"
              required
              autocomplete="name"
              class="border field-edge bg-sky px-3.5 py-2.5 text-sm text-star placeholder:text-faint"
              placeholder="Your name"
            />
          </div>
          <div class="flex flex-col gap-2">
            <label for="email" class="eyebrow text-faint">
              Email
            </label>
            <input
              id="email"
              name="email"
              type="email"
              required
              autocomplete="email"
              class="border field-edge bg-sky px-3.5 py-2.5 text-sm text-star placeholder:text-faint"
              placeholder="you@example.com"
            />
          </div>
        </div>

        <div class="mt-6 flex flex-col gap-2">
          <label for="topic" class="eyebrow text-faint">
            Topic
          </label>
          <select
            id="topic"
            name="topic"
            class="select-log w-full"
          >
            {
              Object.entries(INQUIRY_TOPICS).map(([value, label]) => (
                <option value={value}>{label}</option>
              ))
            }
          </select>
        </div>

        <div class="mt-6 flex flex-col gap-2">
          <label for="message" class="eyebrow text-faint">
            Message
          </label>
          <textarea
            id="message"
            name="message"
            required
            rows="6"
            class="border field-edge bg-sky px-3.5 py-2.5 text-sm text-star placeholder:text-faint"
            placeholder="What are you hoping to do, and roughly where and when?"></textarea>
        </div>

        <div class="mt-7 flex flex-wrap items-center gap-4">
          <button type="submit" class="btn btn-solid">Send message</button>
          <p id="form-status" class="font-mono text-xs text-faint" role="status" aria-live="polite"></p>
        </div>
      </form>

      <div class="lg:col-start-1 lg:row-start-2">
        <dl class="mt-10 space-y-6">
          <div>
            <dt class="eyebrow">Direct</dt>
            <dd class="mt-2">
              <a href={`mailto:${SITE.email}`} class="link-quiet font-mono text-sm">
                {SITE.email}
              </a>
            </dd>
          </div>
          <div>
            <dt class="eyebrow">Elsewhere</dt>
            <dd class="mt-3"><SocialLinks /></dd>
            <dd class="mt-3">
              <a href={SITE.googleBusiness} target="_blank" rel="noopener noreferrer" class="link-quiet text-sm">
                Leave a review on Google →
              </a>
            </dd>
          </div>
          <div>
            <dt class="eyebrow">Station</dt>
            <dd
              class="mt-2 font-mono text-[0.6875rem] uppercase [letter-spacing:var(--tracking-log)] text-faint"
            >
              {SITE.coordinates} · {SITE.region}
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <script src="../scripts/contact-form.ts"></script>
</Base>
