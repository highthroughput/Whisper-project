---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PhotoCard from '../../components/PhotoCard.astro';
import { byDateDesc, formatHours, totalHours } from '../../lib/photos';

const photos = (await getCollection('photos')).sort(byDateDesc);
const archiveHours = photos.reduce((sum, p) => sum + totalHours(p.data.filters), 0);
const keyImage = photos[0]?.data.image;
---

<Base
  title="Gallery"
  description={`The deep-sky archive: ${photos.length} galaxies and nebulae photographed from Central Alberta across ${formatHours(archiveHours)} hours of integration. Acquisition data for every frame.`}
  ogImage={keyImage}
  ogImageAlt={photos[0]?.data.alt}
>
  <section class="mx-auto w-full max-w-7xl px-5 pt-14 sm:px-8 sm:pt-20">
    <p class="eyebrow">The archive</p>
    <div class="mt-3 flex flex-wrap items-end justify-between gap-x-8 gap-y-4">
      <h1 class="font-display text-4xl sm:text-5xl">Gallery</h1>
      <p class="font-mono text-[0.6875rem] uppercase [letter-spacing:var(--tracking-log)] text-faint">
        {photos.length} targets · {formatHours(archiveHours)} h total integration · Bortle 2–4
      </p>
    </div>
    <p class="mt-6 max-w-2xl text-faint">
      Every frame here was gathered under Alberta skies — most from a backyard observatory in
      Central Alberta, the faintest from dark-sky sites in the foothills. Select a photograph to
      view it large; open its observation log for the full acquisition data.
    </p>

    <div class="mt-12 grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
      {
        photos.map((photo, i) => (
          <div class="reveal" style={`--reveal-delay:${(i % 3) * 80}ms`}>
            <PhotoCard photo={photo} lightbox index={i} eager={i < 3} />
          </div>
        ))
      }
    </div>
  </section>

  {/* Lightbox — native <dialog>; cards degrade to plain links without JS */}
  <dialog id="lightbox" class="lightbox" aria-label="Photograph viewer">
    <div class="flex h-full min-h-0 flex-col" data-lb-inner>
      <div class="relative flex min-h-0 flex-1 items-center justify-center px-4 pt-14 pb-2 sm:px-16">
        <img id="lb-image" src="" alt="" class="max-h-full max-w-full object-contain" />
      </div>
      <div
        class="mx-auto flex w-full max-w-7xl flex-wrap items-baseline justify-between gap-x-8 gap-y-2 px-5 pb-6 pt-3 sm:px-8"
      >
        <div class="min-w-0">
          <p id="lb-title" class="font-display text-lg text-star"></p>
          <p
            id="lb-log"
            class="mt-0.5 font-mono text-[0.6875rem] uppercase [letter-spacing:0.08em] text-faint"
          >
          </p>
        </div>
        <a
          id="lb-link"
          href="#"
          class="link-quiet font-mono text-xs uppercase [letter-spacing:var(--tracking-log)]"
        >
          Observation log →
        </a>
      </div>
    </div>
    <button id="lb-close" class="lb-control top-4 right-4" aria-label="Close viewer">
      <svg width="16" height="16" viewBox="0 0 14 14" aria-hidden="true">
        <path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.5"></path>
      </svg>
    </button>
    <button
      id="lb-prev"
      class="lb-control left-3 top-1/2 -translate-y-1/2"
      aria-label="Previous photograph"
    >
      <svg width="18" height="14" viewBox="0 0 18 14" aria-hidden="true">
        <path d="M8 1L2 7l6 6M2 7h15" stroke="currentColor" stroke-width="1.5" fill="none"></path>
      </svg>
    </button>
    <button
      id="lb-next"
      class="lb-control right-3 top-1/2 -translate-y-1/2"
      aria-label="Next photograph"
    >
      <svg width="18" height="14" viewBox="0 0 18 14" aria-hidden="true">
        <path d="M10 1l6 6-6 6M16 7H1" stroke="currentColor" stroke-width="1.5" fill="none"></path>
      </svg>
    </button>
    <p id="lb-status" class="sr-only" aria-live="polite"></p>
  </dialog>

  <script src="../../scripts/lightbox.ts"></script>
</Base>
