---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import telescopeImage from '../assets/rentals/skywatcher-dobsonian.webp';

const rates = [
  {
    term: 'One night',
    detail: 'Pick up same day, return the next day',
    price: 20,
    stripeLink: 'https://buy.stripe.com/5kQ7sN9cabJb0gFgDW3Nm0B',
  },
  {
    term: 'Weekend',
    detail: 'Pick up Friday, drop off Monday',
    price: 35,
    stripeLink: 'https://buy.stripe.com/28E6oJ4VUbJbfbz2N63Nm0C',
  },
  {
    term: 'Weekly',
    detail: 'Pick up day 1, drop off day 8',
    price: 70,
    stripeLink: 'https://buy.stripe.com/dRm28tewu9B3gfD4Ve3Nm0D',
  },
];

const included = [
  'Upgraded Baader zoom eyepiece',
  'Red dot finder',
  'Laser collimator',
  'Dew heater',
  'Red headlamp',
  'Curated observing guide',
  'Setup and assembly directions',
];
---

<Base
  title="Sky-Watcher 10″ Dobsonian Rental"
  description="Rent a Sky-Watcher 10-inch 250P Flextube Dobsonian telescope in Southern Alberta. One night, weekend, and weekly rates, with eyepiece, finder, and accessories included."
>
  <article class="mx-auto w-full max-w-7xl px-5 pt-14 sm:px-8 sm:pt-20">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,7fr)_minmax(22rem,5fr)] lg:gap-16">
      <div>
        <p class="eyebrow">Telescope rental</p>
        <h1 class="mt-3 font-display text-4xl sm:text-5xl">
          Sky-Watcher 10″ 250P Flextube Dobsonian
        </h1>
        <p class="mt-4 max-w-2xl text-faint">
          A 10-inch reflector big enough to hold Saturn's rings, Jupiter's cloud bands, star
          clusters, and galaxies steady in the eyepiece, without the cost or the storage of
          owning one. The collapsible Flextube design sets up in minutes and breaks back down
          for the drive home.
        </p>

        <div class="reveal mt-8 border hairline bg-surface p-4 sm:p-5">
          <Image
            src={telescopeImage}
            alt="The Sky-Watcher 10″ 250P Flextube Dobsonian telescope set up on its rocker base in a living room, showing the primary mirror, focuser with eyepiece, and collapsible truss tube."
            widths={[480, 768, 1080, 1440]}
            sizes="(min-width: 1024px) 55vw, 100vw"
            quality={80}
            loading="eager"
            fetchpriority="high"
            class="w-full object-cover"
          />
        </div>

        <div class="reveal mt-8 max-w-prose space-y-4 text-sm leading-relaxed text-star/85">
          <p>
            The Dobsonian mount is push-to and point-and-look simple, so tracking an object down
            is no harder on your first night than your hundredth. It's the same scope for a
            backyard session, a camping trip, or a dark-sky drive out of the city, and it comes
            back with you no matter how the night went.
          </p>
        </div>

        <section class="mt-10 border hairline bg-surface" aria-labelledby="included-heading">
          <header class="border-b hairline px-5 py-3 font-mono text-[0.6875rem] uppercase [letter-spacing:var(--tracking-log)] text-faint">
            <h2 id="included-heading">Included with every rental</h2>
          </header>
          <ul class="grid gap-x-6 gap-y-2 px-5 py-4 text-sm text-star/85 sm:grid-cols-2">
            {included.map((item) => <li class="flex items-baseline gap-2"><span class="text-dust" aria-hidden="true">·</span>{item}</li>)}
          </ul>
        </section>
      </div>

      <div>
        <section class="border hairline bg-surface" aria-labelledby="rates-heading">
          <header
            class="flex items-baseline justify-between border-b hairline px-5 py-3 font-mono text-[0.6875rem] uppercase [letter-spacing:var(--tracking-log)]"
          >
            <h2 id="rates-heading" class="text-faint">Rental rates</h2>
            <span class="text-dust">CAD</span>
          </header>
          <ul class="px-5 py-2">
            {
              rates.map((rate, i) => (
                <li class:list={['py-4', i > 0 && 'border-t hairline']}>
                  <div class="flex items-baseline justify-between gap-3">
                    <h3 class="font-mono text-sm text-star">{rate.term}</h3>
                    <span class="log-leader" aria-hidden="true" />
                    <span class="tabular-nums text-star">${rate.price}</span>
                  </div>
                  <p class="mt-1 text-xs text-faint">{rate.detail}</p>
                  <a
                    href={rate.stripeLink}
                    class="btn btn-solid mt-3 w-full !text-[0.6875rem]"
                    data-stripe-placeholder
                    aria-label={`Rent for ${rate.term.toLowerCase()}, $${rate.price} CAD`}
                  >
                    Rent · {rate.term}
                  </a>
                </li>
              ))
            }
          </ul>
        </section>

        <p class="mt-4 text-xs leading-relaxed text-faint">
          Pickup and return around Southern Alberta. Every handoff includes a walkthrough of the
          scope and accessories.{' '}
          <a href="/contact?topic=rentals" class="link-quiet">Questions or a custom date range?</a>
        </p>
      </div>
    </div>
  </article>
</Base>
