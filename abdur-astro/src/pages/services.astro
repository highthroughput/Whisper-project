---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import YouTubeEmbed from '../components/YouTubeEmbed.astro';
import ConsultBooking from '../components/ConsultBooking.astro';
import eventPhoto from '../assets/photos/event-photo.jpg';
import { byDateDesc } from '../lib/photos';
import { HOURLY_RATE, TUTORIAL_HOUR_LINKS, CONSULTING_HOUR_LINKS } from '../data/checkout';

// Stripe links and the hourly rate live in src/data/checkout.ts, shared with
// the thank-you page that values a paid session after checkout.

/** Google Calendar Appointment Schedule for the free 15-minute consult intro. */
const CONSULTING_INTRO_CALENDAR_LINK =
  'https://calendar.google.com/calendar/u/0/appointments/schedules/AcZssZ1wzNCPpL-aEZ6LJwf68WjZ8paYbrhmZrqM3Jxy9a14BvZ-sQQ_J75vlf3rvE6275tlJGTk0jzP';
/** One Appointment Schedule per hour, index 0 = 1 hour, for the paid session path. */
const CONSULTING_HOUR_CALENDAR_LINKS: [string, string, string, string, string] = [
  'https://calendar.google.com/calendar/u/0/appointments/schedules/AcZssZ2KQSlQGdNNuRF1WPBwcwv_0bpVmcocmgyBAeDgid-3RAzCtZBK6rGuMyFX3bTbmymVppmglUXw',
  'https://calendar.google.com/calendar/u/0/appointments/schedules/AcZssZ1L7mYmPjRNn5iOI-HtLAekN2BTcRnxv4RLYUXl3E8NDH8pGJY1rDs4PYPMTchGwJVGwG69pUIg',
  'https://calendar.google.com/calendar/u/0/appointments/schedules/AcZssZ2utrLh9BHVcK7XsT8-7cYvCiVY7pcXmZn5WVudg85igQCA00xEcRImVn2zJ-i5lX4rSMM9EYYo',
  'https://calendar.google.com/calendar/u/0/appointments/schedules/AcZssZ3Ss9J_A5C3wxBVQz04ZGPtp6IlbzfCUgFqCvpo3-cvzw5_ujvQHDB13KPPn1pZM61t0KvwZ0Lt',
  'https://calendar.google.com/calendar/u/0/appointments/schedules/AcZssZ35uHG-KkmSGbNe-0BWWb5h58YsDdmyW8nXvrvoPaw0axWNH4gtAejaLUR_mQpCF064DIAce-tQ',
];

// TUTORIALS currently reuse the consulting appointment schedules: there are no
// tutorial-specific ones yet, so a tutorial client's calendar invite will read
// "consulting". Swap these two constants once the tutorial schedules exist.
const TUTORIAL_INTRO_CALENDAR_LINK = CONSULTING_INTRO_CALENDAR_LINK;
const TUTORIAL_HOUR_CALENDAR_LINKS = CONSULTING_HOUR_CALENDAR_LINKS;

const photos = (await getCollection('photos')).sort(byDateDesc);
const keyImage = photos.find((p) => p.id === 'veil-nebula')?.data.image;

const services = [
  {
    id: 'tutorials',
    booking: true,
    topic: 'tutorials',
    title: 'One-on-one tutorials',
    mode: 'Online across Canada · in person around Southern Alberta',
    body: `Astrophotography has a brutal first year: mounts that won't align, stars that won't stay round, stacked images that come out grey. A few hours of direct help collapses months of trial and error. Sessions are built around your gear and your goals: polar alignment and guiding, camera and filter settings, automating a night with N.I.N.A., or processing your own data end-to-end in PixInsight. Online tutorials run over screen-share anywhere in Canada; in-person sessions happen at your setup, under your sky, in and around Southern Alberta. You keep the session notes and every file we touch.`,
  },
  {
    id: 'consulting',
    booking: true,
    topic: 'consulting',
    title: 'Equipment consulting',
    mode: 'Buying advice · remote observatories · astronomy for business',
    body: `The fastest way to waste money in this hobby is to buy twice. Before you order anything, we'll match a telescope, mount, and camera to your targets, your budget, and the realities of your site; then I'll help you assemble and test it so first light actually happens. For observers going deeper, I design and configure remote and backyard setups that run unattended through an Alberta winter. And for lodges, resorts, and venues that want to add astronomy to what they offer their guests, I plan the equipment, the viewing program, and the staff training to make it real.`,
  },
  {
    id: 'speaking',
    topic: 'speaking',
    title: 'Public speaking',
    mode: 'Astronomy events · clubs · schools · festivals',
    body: `A good astronomy talk sends people outside to look up. I speak for astronomy clubs, schools, science festivals, dark-sky events, and corporate audiences across Alberta and beyond, from "what is actually above Alberta tonight" for general audiences to working sessions on deep-sky imaging for practitioners, all illustrated with photographs from this archive and the stories of the nights behind them. Talks are AV-ready, sized to your time slot, and adaptable from a classroom to a festival main stage.`,
  },
  {
    id: 'star-parties',
    topic: 'starparty',
    title: 'Private star parties',
    mode: 'In and around Southern Alberta',
    // The only block with no video or photo to anchor its column, so it carries
    // a spec panel instead. Every row restates something in the copy below.
    specs: [
      ['Where', 'Your acreage, campground, lodge, or venue'],
      ['Good for', 'Family gatherings, camps, team retreats, weddings'],
      ['I bring', 'Telescopes, eyepieces, and the guided tour'],
      ['Weather', 'A call the day before, plus a backup date'],
    ] as [string, string][],
    body: `Some of the best skies in Canada are an easy drive from Calgary, and a telescope changes what an evening outdoors can be. I bring the equipment and the sky-knowledge to your acreage, campground, lodge, or event for a guided tour of the night sky by eye and by telescope: the Moon's terminator, planets, star clusters, and the same nebulae that hang in this gallery. Star parties in Southern Alberta work for family gatherings, camps, team retreats, and weddings; every booking includes a weather call the day before and a backup date, because Alberta.`,
  },
];
---

<Base
  title="Astrophotography Tutorials & Star Parties"
  description="Astronomy services from Southern Alberta: one-on-one astrophotography tutorials online or in person, telescope and equipment consulting, public speaking for astronomy events, and private star parties across Southern Alberta."
  ogImage={keyImage}
>
  <section class="mx-auto w-full max-w-7xl px-5 pt-14 sm:px-8 sm:pt-20">
    <p class="eyebrow">Beyond the archive</p>
    <h1 class="mt-3 font-display text-4xl sm:text-5xl">Services</h1>
    <p class="mt-6 max-w-2xl text-faint">
      The photographs are one output of years spent learning this sky. The rest is teaching it,
      speccing gear for it, and sharing it in person: astronomy tutorials Canada-wide, and
      dark-sky experiences rooted in Southern Alberta. Looking to try a telescope before you buy
      one? See <a href="/rentals" class="link-quiet">scope rentals</a>.
    </p>

    <ul class="mt-14">
      {
        services.map((service, i) => (
          <li id={service.id} class="reveal border-b hairline first:border-t">
            <article class="grid gap-x-12 gap-y-8 py-14 lg:grid-cols-[3.5rem_minmax(0,1fr)_minmax(0,26rem)] xl:grid-cols-[3.5rem_minmax(0,1fr)_minmax(0,30rem)]">
              <span class="font-mono text-[0.6875rem] text-dust">0{i + 1}</span>

              {/* Left: the pitch */}
              <div class="max-w-prose">
                <h2 class="font-display text-3xl">{service.title}</h2>
                <p class="mt-2 font-mono text-[0.6875rem] uppercase [letter-spacing:var(--tracking-log)] text-faint">
                  {service.mode}
                </p>
                <p class="mt-5 leading-relaxed text-star/85">{service.body}</p>
                {/* Tutorials and consulting carry their own booking panel, so a
                    second general-enquiry CTA would compete with the real action. */}
                {!service.booking && (
                  <a
                    href={`/contact?topic=${service.topic}`}
                    class="btn mt-7"
                    aria-label={`Inquire about ${service.title.toLowerCase()}`}
                  >
                    Inquire →
                  </a>
                )}
              </div>

              {/* Right: the proof */}
              <div class="lg:col-start-3">
                {service.id === 'tutorials' && (
                  <div>
                    <p class="eyebrow mb-2 text-faint">A taste of the process</p>
                    <YouTubeEmbed id="6wrQ08Mc2ac" title="NEW Siril Data Processing Guide V2 (Abdur Astro)" />
                  </div>
                )}
                {service.id === 'consulting' && (
                  <div>
                    <p class="eyebrow mb-2 text-faint">Buying advice, on camera</p>
                    <YouTubeEmbed
                      id="ZXVIQyI4_iE"
                      title={'5" APO vs 6" Achromatic Refractor - Which one should you buy? (Abdur Astro)'}
                    />
                  </div>
                )}
                {service.id === 'speaking' && (
                  <div>
                    <p class="eyebrow mb-2 text-faint">On location</p>
                    <div class="border hairline bg-surface p-4 sm:p-5">
                      <Image
                        src={eventPhoto}
                        alt="Abdur speaking to a crowd at an outdoor public astronomy event, beside a red Coronado solar telescope set up on a tracking mount."
                        widths={[420, 640, 960]}
                        sizes="(min-width: 1280px) 30rem, (min-width: 1024px) 26rem, 92vw"
                        class="aspect-[3/2] w-full object-cover"
                        loading="lazy"
                        quality={80}
                      />
                    </div>
                  </div>
                )}
                {'specs' in service && service.specs && (
                  <section class="border hairline bg-surface" aria-label={`What ${service.title.toLowerCase()} include`}>
                    <header class="border-b hairline px-5 py-3 font-mono text-[0.6875rem] uppercase [letter-spacing:var(--tracking-log)]">
                      <h3 class="text-faint">What a night looks like</h3>
                    </header>
                    {/* Stacked rather than leader-ruled: these values are phrases,
                        and right-aligning them across a leader orphans the last word. */}
                    <dl class="py-2 font-mono text-[0.8125rem]">
                      {service.specs.map(([label, value], row) => (
                        <div class:list={['px-5 py-3', row > 0 && 'border-t hairline']}>
                          <dt class="text-[0.6875rem] uppercase [letter-spacing:var(--tracking-log)] text-faint">
                            {label}
                          </dt>
                          <dd class="mt-1.5 leading-relaxed text-star">{value}</dd>
                        </div>
                      ))}
                    </dl>
                  </section>
                )}
              </div>

              {/* The booking panels are their own grid children rather than part
                  of the pitch column: that lets the single-column phone stack run
                  copy, video, booking while `lg:` pins them back under the copy. */}
              {service.id === 'tutorials' && (
                <ConsultBooking
                  id="tutorial"
                  service="tutorial"
                  category="tutorial"
                  fitSubject="a tutorial"
                  heading="Book a tutorial"
                  hourlyLinks={TUTORIAL_HOUR_LINKS}
                  introCalendarLink={TUTORIAL_INTRO_CALENDAR_LINK}
                  hourlyCalendarLinks={TUTORIAL_HOUR_CALENDAR_LINKS}
                  ratePerHour={HOURLY_RATE}
                  class="max-w-prose lg:col-start-2 lg:row-start-2"
                />
              )}
              {service.id === 'consulting' && (
                <ConsultBooking
                  id="consult"
                  service="equipment consulting"
                  category="consulting"
                  fitSubject="equipment consulting"
                  hourlyLinks={CONSULTING_HOUR_LINKS}
                  introCalendarLink={CONSULTING_INTRO_CALENDAR_LINK}
                  hourlyCalendarLinks={CONSULTING_HOUR_CALENDAR_LINKS}
                  ratePerHour={HOURLY_RATE}
                  class="max-w-prose lg:col-start-2 lg:row-start-2"
                />
              )}
            </article>
          </li>
        ))
      }
    </ul>

    <p class="reveal mt-12 max-w-2xl text-sm text-faint">
      Not sure which of these fits? <a href="/contact" class="link-quiet">Write anyway</a>. A
      two-line description of what you're after is plenty to start.
    </p>
  </section>
</Base>

<script>
  import { viewItemList } from '../lib/track';

  // Tutorials and consulting are bought on this page, so it counts as their
  // product view. Values are one hour, the "from" price.
  const rate = Number(document.querySelector<HTMLElement>('.consult-booking')?.dataset.rate ?? 0);
  viewItemList(
    'Services',
    [
      { id: 'tutorial', name: 'One-on-one tutorial', variant: '1 hour', category: 'tutorial', value: rate },
      { id: 'consulting', name: 'Equipment consulting', variant: '1 hour', category: 'consulting', value: rate },
    ],
    true,
  );
</script>

