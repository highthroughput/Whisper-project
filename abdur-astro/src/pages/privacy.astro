---
/**
 * Plain-language privacy notice. It describes only what the site actually
 * does: the measurement section follows SITE.tracking, so it can't claim tags
 * that aren't loaded, or leave out ones that are.
 *
 * Reviewed against PIPEDA and Alberta's PIPA as a notice, not legal advice;
 * have it read over before running paid ads at any scale.
 */
import Base from '../layouts/Base.astro';
import { SITE } from '../config';

const t = SITE.tracking;
const usesMeta = Boolean(t.metaPixelId.trim());
const usesGoogle = Boolean(t.ga4Id.trim() || t.googleAdsId.trim());
const measuring = usesMeta || usesGoogle;
const usesAds = Boolean(t.googleAdsId.trim());
const usesGa4 = Boolean(t.ga4Id.trim());
const tools = [usesMeta && 'the Meta Pixel', usesGoogle && 'the Google tag'].filter(Boolean).join(' and ');
const optIn = t.consent === 'opt-in';
// Google is always a processor (Sheets for form copies, Calendar for booking);
// Meta only when its pixel is actually configured.
const processors = ['Stripe', 'Google', usesMeta && 'Meta', 'Web3Forms'].filter(Boolean).join(', ');
const updated = 'September 26, 2026';
---

<Base
  title="Privacy"
  description="What Abdur Astro collects when you buy a print, book a session or rental, or send a message, who handles it, and how to turn off ad measurement."
>
  <article class="mx-auto w-full max-w-7xl px-5 pt-14 sm:px-8 sm:pt-20">
    <p class="eyebrow">Privacy</p>
    <h1 class="mt-3 font-display text-4xl sm:text-5xl">What this site collects</h1>
    <p class="mt-4 font-mono text-[0.6875rem] uppercase [letter-spacing:var(--tracking-log)] text-faint">
      Updated {updated}
    </p>

    <div class="mt-10 max-w-prose space-y-10 leading-relaxed text-star/85">
      <section>
        <p>
          Abdur Astro is a one-person astrophotography business in Southern Alberta. This page
          covers what you share when you use abdurastro.com, why, and the services that handle
          it. Abdur is responsible for how it's handled; questions or requests go to him at{' '}
          <a href={`mailto:${SITE.email}`} class="link-quiet">{SITE.email}</a>.
        </p>
      </section>

      <section aria-labelledby="p-forms">
        <h2 id="p-forms" class="font-display text-2xl text-star">Messages and bookings</h2>
        <p class="mt-3">
          The contact form, the email sign-up, and the tutorial, consulting and rental booking
          forms collect what you type into them: usually your name, email address, a message,
          and for a rental the dates you picked. Each submission is delivered by email through
          Web3Forms and copied to a private Google Sheet, so it can be answered and the booking
          kept track of. Picking a session time happens on Google Calendar's own booking page.
        </p>
      </section>

      <section aria-labelledby="p-pay">
        <h2 id="p-pay" class="font-display text-2xl text-star">Payments</h2>
        <p class="mt-3">
          Checkout runs on Stripe. Stripe collects your card details directly and this site
          never sees them. What comes back is what's needed to fill the order: your name, email,
          shipping address for a print, and what you bought. Order records are kept for six
          years, as Canadian tax rules require.
        </p>
      </section>

      <section aria-labelledby="p-measure">
        <h2 id="p-measure" class="font-display text-2xl text-star">Ad measurement</h2>
        {
          measuring ? (
            <>
              <p class="mt-3">
                This site uses {tools} to learn which ads and posts lead to a sale or a booking.
                They record the pages you visit and actions such as viewing a print, starting a
                checkout, sending a form or completing a purchase, and they set cookies to do it.
                {usesMeta && ' Meta may use this to show you Abdur Astro ads on Facebook and Instagram.'}
                {usesGoogle && ' Google may use it to measure and show Abdur Astro ads in Google Search and on YouTube.'}{' '}
                No form contents, card details or addresses are sent to either.
                {usesGa4 && ' Analytics data is kept for up to 14 months.'}
              </p>
              {usesAds && (
                <p class="mt-3">
                  Third-party vendors, including Google, use cookies to serve ads based on your
                  prior visits to this website or other websites. Google's use of advertising
                  cookies lets it and its partners serve ads based on those visits. You can opt
                  out of personalized advertising in{' '}
                  <a href="https://adssettings.google.com/" class="link-quiet" rel="noopener noreferrer" target="_blank">Google's ad settings</a>, or of other vendors' cookies at{' '}
                  <a href="https://optout.aboutads.info/" class="link-quiet" rel="noopener noreferrer" target="_blank">aboutads.info</a>. Google explains{' '}
                  <a href="https://policies.google.com/technologies/partner-sites" class="link-quiet" rel="noopener noreferrer" target="_blank">how it uses information from sites that use its services</a>.
                </p>
              )}
              <p class="mt-3">
                {optIn
                  ? 'Nothing loads unless you turn it on, here or in the banner, and you can turn it back off at any time.'
                  : 'You can turn this off for this browser below.'}{' '}
                If your browser sends a Global Privacy Control signal, or blocks site storage, it
                stays off.
              </p>
              <div class="mt-5 border hairline bg-surface p-5" data-tracking-control>
                <p class="font-mono text-[0.6875rem] uppercase [letter-spacing:var(--tracking-log)] text-faint">
                  Ad measurement on this browser
                </p>
                {/* Empty until the script fills it, so a no-JS visitor sees only
                    the noscript line rather than a status that never resolves.
                    role="status" announces the result of pressing the button. */}
                <p class="mt-2 text-sm" data-tracking-state role="status" />
                <button type="button" class="btn btn-sm mt-4" data-tracking-toggle hidden />
                <noscript>
                  <p class="mt-2 text-sm text-faint">
                    With JavaScript off, none of these tools load.
                  </p>
                </noscript>
              </div>
              <p class="mt-4 text-sm text-faint">
                You can also manage ad settings with each company directly:{' '}
                {usesMeta && (
                  <a href="https://accountscenter.facebook.com/ad_preferences" class="link-quiet" rel="noopener noreferrer" target="_blank">Meta ad preferences</a>
                )}
                {usesMeta && usesGoogle && ' · '}
                {usesGoogle && (
                  <a href="https://myadcenter.google.com/" class="link-quiet" rel="noopener noreferrer" target="_blank">Google My Ad Center</a>
                )}.
              </p>
            </>
          ) : (
            <p class="mt-3">
              This site doesn't currently use advertising or analytics tags. If that changes,
              this section will say which ones and give you a way to turn them off.
            </p>
          )
        }
      </section>

      <section aria-labelledby="p-embeds">
        <h2 id="p-embeds" class="font-display text-2xl text-star">Videos</h2>
        <p class="mt-3">
          Embedded YouTube videos use YouTube's privacy-enhanced mode, which doesn't store
          viewing cookies until you press play.
        </p>
      </section>

      <section aria-labelledby="p-where">
        <h2 id="p-where" class="font-display text-2xl text-star">Where it's handled</h2>
        <p class="mt-3">
          {processors} and Cloudflare, which hosts the site, may process and store information
          outside Canada, including in the United States, under their own
          privacy policies. Nothing is sold, and nothing is shared beyond what these services
          need to do their part.
        </p>
      </section>

      <section aria-labelledby="p-rights">
        <h2 id="p-rights" class="font-display text-2xl text-star">Your requests</h2>
        <p class="mt-3">
          You can ask what information is held about you, have it corrected, or have it
          deleted where it isn't needed for an order or the tax record. Email{' '}
          <a href={`mailto:${SITE.email}`} class="link-quiet">{SITE.email}</a> and expect an
          answer within 30 days. To stop emails, reply to any of them and say so.
        </p>
      </section>
    </div>
  </article>
</Base>

<script>
  import { setTrackingChoice, trackingChoice } from '../lib/track';

  const box = document.querySelector<HTMLElement>('[data-tracking-control]');
  const state = box?.querySelector<HTMLElement>('[data-tracking-state]');
  const toggle = box?.querySelector<HTMLButtonElement>('[data-tracking-toggle]');
  const gpc = navigator.globalPrivacyControl === true;
  const consentMode = window.aaTrackingConsent ?? 'opt-out';

  const isOn = () => {
    if (gpc || window.aaStorageBlocked) return false;
    const choice = trackingChoice();
    return consentMode === 'opt-in' ? choice === 'on' : choice !== 'off';
  };

  const render = () => {
    if (!state || !toggle) return;
    if (gpc) {
      state.textContent = 'Off. Your browser sends Global Privacy Control, so nothing loads.';
      toggle.hidden = true;
      return;
    }
    if (window.aaStorageBlocked) {
      state.textContent = 'Off. This browser blocks site storage, so none of these tools load.';
      toggle.hidden = true;
      return;
    }
    const on = isOn();
    state.textContent = on ? 'On.' : 'Off. None of these tools load on this browser.';
    toggle.textContent = on ? 'Turn it off' : 'Turn it on';
    toggle.hidden = false;
  };

  toggle?.addEventListener('click', () => {
    const turningOn = !isOn();
    const saved = setTrackingChoice(turningOn ? 'on' : 'off');
    if (!saved) {
      if (state) state.textContent = "This browser wouldn't save the choice, so it can't be changed here.";
      return;
    }
    if (turningOn) window.aaLoadTracking?.();
    else window.aaStopTracking?.();
    render();
    // The site's own events stop at once, but a tag already loaded on this
    // page can't be fully unloaded, so the message only promises the rest
    // from the next page.
    if (!turningOn && state) {
      state.textContent = "Off. This site's events stop now, and the tools won't load from the next page.";
    }
  });

  render();
</script>
