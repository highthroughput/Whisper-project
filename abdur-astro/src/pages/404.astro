---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page not found"
  description="Nothing at these coordinates — return to the Abdur Astro archive of deep-sky astrophotography from Central Alberta."
>
  <section class="mx-auto flex w-full max-w-7xl flex-col items-start px-5 pt-24 sm:px-8 sm:pt-32">
    <p class="eyebrow">Error 404 · No object at these coordinates</p>
    <h1 class="mt-4 font-display text-4xl sm:text-6xl">Empty field.</h1>
    <p class="mt-6 max-w-md text-faint">
      Either this page moved, or it was never catalogued. The archive, however, is exactly
      where it should be.
    </p>
    <div class="mt-8 flex flex-wrap gap-4">
      <a href="/" class="btn">Return home</a>
      <a href="/gallery" class="btn btn-solid">Open the gallery</a>
    </div>
  </section>
</Base>
