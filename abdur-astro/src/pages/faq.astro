---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FaqList from '../components/FaqList.astro';
import { cleanPathname } from '../lib/urls';
import { breadcrumbJsonLd, type Crumb } from '../lib/breadcrumbs';
import { faqPageJsonLd, getFaqGroups } from '../data/faq';

const groups = await getFaqGroups();
const canonical = new URL(cleanPathname(Astro.url.pathname), Astro.site).href;
const crumbs: Crumb[] = [{ label: 'FAQ' }];
const links: Record<string, { label: string; href: string }> = {
  rentals: { label: 'Telescope rentals →', href: '/rentals' },
  'star-parties': { label: 'Star parties →', href: '/star-parties' },
  prints: { label: 'Prints →', href: '/prints' },
};
---

<Base
  title="FAQ · Rentals, Star Parties & Prints"
  description="Answers about renting a telescope, booking a private star party and ordering a print from Abdur Astro in Cochrane, Alberta."
  schema={[faqPageJsonLd(groups.flatMap((g) => g.items)), breadcrumbJsonLd(crumbs, Astro.site, canonical)]}
>
  <section class="mx-auto w-full max-w-5xl px-5 pt-14 sm:px-8 sm:pt-20">
    <Breadcrumbs crumbs={crumbs} class="mb-6" />
    <p class="eyebrow">Before you book</p>
    <h1 class="mt-3 font-display text-4xl sm:text-5xl">Questions</h1>
    <p class="mt-6 max-w-2xl text-faint">
      Renting a telescope, booking a private star party, ordering a print. Anything not answered
      here, <a href="/contact" class="link-quiet">ask</a>.
    </p>

    <nav aria-label="FAQ sections" class="mt-8 flex flex-wrap gap-x-6 font-mono text-[0.6875rem] uppercase [letter-spacing:var(--tracking-log)]">
      {
        groups.map((group) => (
          <a href={`#${group.id}`} class="inline-flex min-h-11 items-center text-faint hover:text-star">
            {group.title}
          </a>
        ))
      }
    </nav>

    {
      groups.map((group, i) => (
        <section id={group.id} class="reveal mt-12 scroll-mt-24" aria-labelledby={`${group.id}-heading`}>
          <div class="flex items-baseline gap-4">
            <span class="font-mono text-[0.6875rem] text-dust" aria-hidden="true">
              0{i + 1}
            </span>
            <h2 id={`${group.id}-heading`} class="font-display text-3xl">
              {group.title}
            </h2>
          </div>
          <FaqList items={group.items} class="mt-6" />
          <a href={links[group.id].href} class="link-quiet mt-4 inline-flex min-h-11 items-center text-sm">
            {links[group.id].label}
          </a>
        </section>
      ))
    }
  </section>
</Base>
