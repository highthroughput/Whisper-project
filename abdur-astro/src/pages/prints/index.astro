---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PrintCard from '../../components/PrintCard.astro';

const prints = (await getCollection('prints')).sort((a, b) => a.data.order - b.data.order);
const keyImage = prints[0]?.data.image;
---

<Base
  title="Fine Art Prints"
  description="Fine art astrophotography prints from Central Alberta — archival giclée galaxy and nebula prints on museum-grade cotton papers, signed and shipped across Canada."
  ogImage={keyImage}
  ogImageAlt={prints[0]?.data.alt}
>
  <section class="mx-auto w-full max-w-7xl px-5 pt-14 sm:px-8 sm:pt-20">
    <p class="eyebrow">The print shop</p>
    <h1 class="mt-3 font-display text-4xl sm:text-5xl">Prints</h1>
    <p class="mt-6 max-w-2xl text-faint">
      Each photograph in the shop is produced as an archival pigment giclée from the original
      master file — the same data, hours deep, that appears in the gallery. Signed, shipped
      across Canada, and made to hold their blacks for a lifetime.
    </p>

    <div class="mt-12 grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
      {
        prints.map((print, i) => (
          <div class="reveal" style={`--reveal-delay:${(i % 3) * 80}ms`}>
            <PrintCard print={print} eager={i < 3} />
          </div>
        ))
      }
    </div>
  </section>

  <section
    class="mx-auto mt-24 w-full max-w-7xl px-5 sm:px-8"
    aria-labelledby="printing-shipping-heading"
  >
    <div class="reveal border-t hairline pt-12">
      <p class="eyebrow">Printing &amp; shipping</p>
      <h2 id="printing-shipping-heading" class="mt-3 font-display text-3xl">
        Made to archival standard
      </h2>
      <div class="mt-8 grid gap-10 text-sm text-faint md:grid-cols-3">
        <div>
          <h3 class="font-mono text-[0.6875rem] uppercase [letter-spacing:var(--tracking-log)] text-star">
            The print
          </h3>
          <p class="mt-3 leading-relaxed">
            Archival pigment giclée on 100% cotton papers — a velvety archival matte, or a
            baryta fibre paper with the depth of a darkroom print. Museum-grade inks rated
            beyond a lifetime of display.
          </p>
        </div>
        <div>
          <h3 class="font-mono text-[0.6875rem] uppercase [letter-spacing:var(--tracking-log)] text-star">
            Shipping
          </h3>
          <p class="mt-3 leading-relaxed">
            Ships across Canada, rolled in a rigid tube with the certificate of authenticity.
            Current turnaround: 7–10 business days from order to dispatch.{' '}
            <span class="opacity-70">(Turnaround is a placeholder — confirm before launch.)</span>
          </p>
        </div>
        <div>
          <h3 class="font-mono text-[0.6875rem] uppercase [letter-spacing:var(--tracking-log)] text-star">
            Checkout
          </h3>
          <p class="mt-3 leading-relaxed">
            Prices in CAD; secure checkout via Stripe with shipping and applicable taxes
            calculated there. Questions about sizes, framing, or international orders —
            <a href="/contact?topic=prints" class="link-quiet">get in touch</a>.
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>
