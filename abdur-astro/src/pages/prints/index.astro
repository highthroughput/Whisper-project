---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PrintCard from '../../components/PrintCard.astro';
import { DUTIES_NOTE } from '../../config';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FaqList from '../../components/FaqList.astro';
import { faqPageJsonLd, getFaqGroups } from '../../data/faq';
import { cleanPathname } from '../../lib/urls';
import { breadcrumbJsonLd, type Crumb } from '../../lib/breadcrumbs';

const prints = (await getCollection('prints')).sort((a, b) => a.data.order - b.data.order);
const keyImage = prints[0]?.data.image;
const canonical = new URL(cleanPathname(Astro.url.pathname), Astro.site).href;
const crumbs: Crumb[] = [{ label: 'Prints' }];
const faq = (await getFaqGroups()).find((group) => group.id === 'prints')!;

// The description quotes the shop's own numbers, so it follows a repricing.
const options = prints.flatMap((p) => p.data.options);
const from = Math.min(...options.map((o) => o.price));
const words = ['zero', 'one', 'two', 'three', 'four', 'five', 'six'];
const count = (n: number) => words[n] ?? String(n);
const papers = count(new Set(options.map((o) => o.paper)).size);
const sizes = count(new Set(options.map((o) => o.size)).size);
const description = `Archival giclée prints of galaxies and nebulae photographed from Alberta, from $${from} CAD. ${papers[0].toUpperCase()}${papers.slice(1)} papers, ${sizes} sizes, shipped across North America.`;
---

<Base
  title="Astrophotography Prints · Galaxy & Nebula Wall Art from Alberta"
  description={description}
  ogImage={keyImage}
  ogImageAlt={prints[0]?.data.alt}
  schema={[faqPageJsonLd(faq.items), breadcrumbJsonLd(crumbs, Astro.site, canonical)]}
>
  <section class="mx-auto w-full max-w-7xl px-5 pt-14 sm:px-8 sm:pt-20">
    <Breadcrumbs crumbs={crumbs} class="mb-6" />
    <p class="eyebrow">The print shop</p>
    <h1 class="mt-3 font-display text-4xl sm:text-5xl">Prints</h1>
    <p class="mt-6 max-w-2xl text-faint">
      Each photograph in the shop is produced as an archival pigment giclée from the original
      master file: the same data, hours deep, that appears in the gallery. Shipped across
      North America, and made to hold their blacks for a lifetime.
    </p>

    <div class="mt-12 grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
      {
        prints.map((print, i) => (
          <div class="reveal" style={`--reveal-delay:${(i % 3) * 80}ms`}>
            <PrintCard print={print} eager={i < 3} />
          </div>
        ))
      }
    </div>
  </section>

  <section
    class="mx-auto mt-24 w-full max-w-7xl px-5 sm:px-8"
    aria-labelledby="printing-shipping-heading"
  >
    <div class="reveal border-t hairline pt-12">
      <p class="eyebrow">Printing &amp; shipping</p>
      <h2 id="printing-shipping-heading" class="mt-3 font-display text-3xl sm:text-4xl">
        Made to archival standard
      </h2>
      <div class="mt-8 grid gap-10 text-sm text-star/85 md:grid-cols-3">
        <div>
          <h3 class="font-mono text-[0.6875rem] uppercase [letter-spacing:var(--tracking-log)] text-star">
            The print
          </h3>
          <p class="mt-3 leading-relaxed">
            Archival pigment giclée on two papers: a velvety archival matte, or Hahnemühle
            FineArt Pearl, an acid-free paper with a subtle pearl-gloss finish that keeps the
            blacks deep. Museum-grade inks rated beyond a lifetime of display.
          </p>
        </div>
        <div>
          <h3 class="font-mono text-[0.6875rem] uppercase [letter-spacing:var(--tracking-log)] text-star">
            Shipping
          </h3>
          <p class="mt-3 leading-relaxed">
            Ships across North America, rolled in a rigid tube with the certificate of authenticity.
            Current turnaround: 7–10 business days from order to dispatch.{' '}
            <span data-duties-note>{DUTIES_NOTE}</span>
          </p>
        </div>
        <div>
          <h3 class="font-mono text-[0.6875rem] uppercase [letter-spacing:var(--tracking-log)] text-star">
            Checkout
          </h3>
          <p class="mt-3 leading-relaxed">
            Prices in CAD; secure checkout via Stripe with shipping and applicable taxes
            calculated there. Questions about sizes, framing, or international orders?{' '}
            <a href="/contact?topic=prints" class="link-quiet">Get in touch</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto mt-20 w-full max-w-7xl px-5 sm:px-8" aria-labelledby="print-faq-heading">
    <div class="reveal max-w-3xl border-t hairline pt-12">
      <p class="eyebrow">Before you order</p>
      <h2 id="print-faq-heading" class="mt-3 font-display text-3xl sm:text-4xl">Print questions</h2>
      <FaqList items={faq.items} class="mt-6" />
      <p class="mt-6 text-sm text-faint">
        Rentals and star parties are in the <a href="/faq" class="link-quiet">full FAQ</a>.
      </p>
    </div>
  </section>
  <div
    hidden
    data-print-list={JSON.stringify(
      prints.map((print) => ({
        id: print.id,
        name: `${print.data.title} print`,
        category: 'print',
        value: Math.min(...print.data.options.map((o) => o.price)),
      })),
    )}
  />
</Base>

<script>
  import { viewItemList, type TrackedItem } from '../../lib/track';

  // An index, not a place to buy: GA4 gets the list, Meta doesn't get a
  // product view (each print page sends its own).
  const el = document.querySelector<HTMLElement>('[data-print-list]');
  try {
    viewItemList('Prints', JSON.parse(el?.dataset.printList ?? '[]') as TrackedItem[]);
  } catch {
    /* malformed data: skip the event rather than break the page */
  }
</script>

