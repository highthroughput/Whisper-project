---
import { Image, getImage } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { cleanPathname } from '../../lib/urls';
import PrintOptions from '../../components/PrintOptions.astro';
import { printVariants, sizeInInches } from '../../lib/prints';
import { PRINT_SLIDE_IMAGE, photoCredit } from '../../lib/imageMeta';

export async function getStaticPaths() {
  const prints = await getCollection('prints');
  return prints.map((print) => ({ params: { slug: print.id }, props: { print } }));
}

const { print } = Astro.props;
const { data } = print;
const { Content } = await render(print);

const photos = await getCollection('photos');
const photo = data.photo ? photos.find((p) => p.id === data.photo) : undefined;

const from = Math.min(...data.options.map((o) => o.price));

// The framed piece leads: it is what someone is buying. The artwork follows.
const slides = [
  ...(data.lifestyleImage
    ? [
        {
          kind: 'framed' as const,
          src: data.lifestyleImage,
          alt: data.lifestyleAlt ?? `${data.title} print, framed and hung on a wall.`,
          label: 'The print, framed',
        },
      ]
    : []),
  { kind: 'artwork' as const, src: data.image, alt: data.alt, label: 'The photograph' },
];


const canonical = new URL(cleanPathname(Astro.url.pathname), Astro.site).href;
const description = `${data.title} fine art print: archival giclée astrophotography from Alberta on matte or baryta cotton papers, ${data.options[0].size} to ${data.options[data.options.length - 1].size}, from $${from} CAD. Ships across North America.`;

// Google's merchant listings ask for the product image at 1:1, 4:3 and 16:9.
// The master is 3:2, so each is a centred crop of the full-resolution file.
const productImages = await Promise.all(
  [
    [1200, 1200],
    [1200, 900],
    [1200, 675],
  ].map(async ([width, height]) => {
    const image = await getImage({ src: data.image, width, height, fit: 'cover', format: 'jpeg', quality: 80 });
    return new URL(image.src, Astro.site).href;
  }),
);

// One product group, one variant per size and paper. Each variant's offer
// links to the page with that option preselected (?size=…&paper=…), which is
// what Google's variant guidance requires of a page where options are picked
// with a script; the group keeps the page's one canonical URL.
const productGroup = {
  '@context': 'https://schema.org',
  '@type': 'ProductGroup',
  name: `${data.title} · Fine Art Astrophotography Print`,
  description: data.tagline,
  url: canonical,
  image: productImages,
  brand: { '@type': 'Brand', name: 'Abdur Astro' },
  category: 'Fine art print',
  productGroupID: print.id,
  variesBy: ['https://schema.org/size', 'https://schema.org/material'],
  hasVariant: printVariants(print.id, data.options).map(({ option, sku, query }) => ({
    '@type': 'Product',
    sku,
    name: `${data.title} print · ${option.size} · ${option.paper}`,
    image: productImages,
    size: sizeInInches(option.size),
    material: option.paper,
    offers: {
      '@type': 'Offer',
      url: `${canonical}?${query}`,
      price: option.price.toFixed(2),
      priceCurrency: 'CAD',
      availability: 'https://schema.org/InStock',
      itemCondition: 'https://schema.org/NewCondition',
    },
  })),
};

// Credit for each photograph shown on this page, framed view and artwork.
const credits = await Promise.all(slides.map((slide) => photoCredit(slide.src, PRINT_SLIDE_IMAGE, Astro.site)));
---

<Base
  title={`${data.title} Print`}
  description={description}
  ogImage={data.image}
  ogImageAlt={data.alt}
  schema={[productGroup, ...credits]}
>
  <article class="mx-auto w-full max-w-7xl px-5 pt-14 sm:px-8 sm:pt-20">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,7fr)_minmax(22rem,5fr)] lg:gap-16">
      {/* One image at a time, swiped. Native CSS scroll-snap does the swiping,
          so it works on a phone with no JavaScript at all; the dots and the
          arrows are enhancement layered on top. */}
      <div class="print-gallery">
        <ul
          data-track
          tabindex="0"
          role="group"
          aria-label={`${data.title} images`}
          class="flex snap-x snap-mandatory overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
        >
          {
            slides.map((slide, i) => (
              <li class="w-full shrink-0 snap-center">
                <figure>
                  <div class="border hairline bg-surface p-4 sm:p-5">
                    <Image
                      src={slide.src}
                      alt={slide.alt}
                      widths={PRINT_SLIDE_IMAGE.widths}
                      sizes={PRINT_SLIDE_IMAGE.sizes}
                      quality={PRINT_SLIDE_IMAGE.quality}
                      loading={i === 0 ? 'eager' : 'lazy'}
                      fetchpriority={i === 0 ? 'high' : undefined}
                      class="w-full object-contain"
                    />
                  </div>
                  <figcaption class="mt-3 font-mono text-[0.6875rem] uppercase [letter-spacing:var(--tracking-log)] text-faint">
                    {slide.kind === 'artwork' && photo ? (
                      <>
                        {photo.data.target}
                        {photo.data.captured && ` · ${photo.data.captured}`} ·{' '}
                        <a href={`/gallery/${photo.id}`} class="link-quiet normal-case">
                          View the observation log →
                        </a>
                      </>
                    ) : (
                      slide.label
                    )}
                  </figcaption>
                </figure>
              </li>
            ))
          }
        </ul>

        {
          slides.length > 1 && (
            /* Dots and arrows are script-driven; without it the track still
               swipes natively, so dead controls are hidden rather than shown. */
            <div class="js-only mt-4 flex items-center justify-between gap-4">
              <div class="flex gap-2" data-dots>
                {slides.map((slide, i) => (
                  <button
                    type="button"
                    data-dot
                    data-index={i}
                    aria-label={`Show ${slide.label.toLowerCase()}`}
                    class="h-2.5 w-2.5 rounded-full border border-star/40 transition-colors duration-200"
                  />
                ))}
              </div>
              <div class="flex gap-2">
                <button type="button" data-prev class="lb-control static h-9 w-9 disabled:cursor-not-allowed disabled:opacity-35" aria-label="Previous image">
                  <svg width="16" height="12" viewBox="0 0 18 14" aria-hidden="true">
                    <path d="M8 1L2 7l6 6M2 7h15" stroke="currentColor" stroke-width="1.5" fill="none" />
                  </svg>
                </button>
                <button type="button" data-next class="lb-control static h-9 w-9 disabled:cursor-not-allowed disabled:opacity-35" aria-label="Next image">
                  <svg width="16" height="12" viewBox="0 0 18 14" aria-hidden="true">
                    <path d="M10 1l6 6-6 6M16 7H1" stroke="currentColor" stroke-width="1.5" fill="none" />
                  </svg>
                </button>
              </div>
            </div>
          )
        }
      </div>

      <div>
        <p class="eyebrow">Fine art print</p>
        <h1 class="mt-3 font-display text-4xl sm:text-5xl">{data.title}</h1>
        <p class="mt-4 text-faint">{data.tagline}</p>
        {/* The price belongs above the fold, and the edition drops to faint so the
            title is not sandwiched between two identical dust-orange labels. */}
        <div class="mt-5 flex flex-wrap items-baseline gap-x-4 gap-y-1">
          <p class="font-display text-2xl tabular-nums text-star">From ${from} CAD</p>
          <p class="font-mono text-[0.6875rem] uppercase [letter-spacing:var(--tracking-log)] text-faint">
            {data.edition}
          </p>
        </div>

        <div class="reveal mt-8 max-w-prose text-sm leading-relaxed text-star/85 [&_p]:mb-4 [&_p:last-child]:mb-0">
          <Content />
        </div>

        <PrintOptions options={data.options} title={data.title} id={print.id} class="mt-10" />

        <div class="mt-6 space-y-2 text-xs leading-relaxed text-faint">
          <p>
            Archival pigment giclée · 100% cotton papers · signed
            {data.edition.toLowerCase().includes('limited') && ' and numbered'} · certificate of
            authenticity included.
          </p>
          <p>
            Ships across North America in a rigid tube. Turnaround currently 7–10 business days.
            Shipping and taxes calculated at Stripe checkout.{' '}
            <a href="/contact?topic=prints" class="link-quiet">Questions?</a>
          </p>
        </div>
      </div>
    </div>
  </article>
</Base>
<script>
  document.querySelectorAll<HTMLElement>('.print-gallery').forEach((gallery) => {
    const track = gallery.querySelector<HTMLElement>('[data-track]');
    const dots = [...gallery.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    const prev = gallery.querySelector<HTMLButtonElement>('[data-prev]');
    const next = gallery.querySelector<HTMLButtonElement>('[data-next]');
    if (!track || dots.length < 2) return;

    const slides = [...track.children] as HTMLElement[];
    const activeDot = 'bg-dust border-dust';

    // Derived from scroll position, not from a counter, so it stays correct
    // however the slide changed: swipe, dot, arrow, keyboard or trackpad.
    const currentIndex = () =>
      Math.round(track.scrollLeft / (track.scrollWidth / slides.length));

    const sync = () => {
      const i = Math.min(Math.max(currentIndex(), 0), slides.length - 1);
      dots.forEach((dot, n) => {
        dot.classList.toggle('bg-dust', n === i);
        dot.classList.toggle('border-dust', n === i);
        dot.setAttribute('aria-current', n === i ? 'true' : 'false');
      });
      if (prev) prev.disabled = i === 0;
      if (next) next.disabled = i === slides.length - 1;
    };

    const goTo = (i: number) => {
      const clamped = Math.min(Math.max(i, 0), slides.length - 1);
      track.scrollTo({ left: slides[clamped].offsetLeft - track.offsetLeft, behavior: 'smooth' });
    };

    dots.forEach((dot) => dot.addEventListener('click', () => goTo(Number(dot.dataset.index))));
    prev?.addEventListener('click', () => goTo(currentIndex() - 1));
    next?.addEventListener('click', () => goTo(currentIndex() + 1));
    track.addEventListener('scroll', () => requestAnimationFrame(sync), { passive: true });
    window.addEventListener('resize', sync);
    sync();
  });
</script>

