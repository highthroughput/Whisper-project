---
import { Image, getImage } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { cleanPathname } from '../../lib/urls';

export async function getStaticPaths() {
  const prints = await getCollection('prints');
  return prints.map((print) => ({ params: { slug: print.id }, props: { print } }));
}

const { print } = Astro.props;
const { data } = print;
const { Content } = await render(print);

const photos = await getCollection('photos');
const photo = data.photo ? photos.find((p) => p.id === data.photo) : undefined;

const from = Math.min(...data.options.map((o) => o.price));

// Ledger rows grouped by size, preserving frontmatter order.
const sizes = [...new Set(data.options.map((o) => o.size))].map((size) => ({
  size,
  papers: data.options.filter((o) => o.size === size),
}));

const canonical = new URL(cleanPathname(Astro.url.pathname), Astro.site).href;
const description = `${data.title} fine art print: archival giclée astrophotography from Alberta on matte or baryta cotton papers, ${data.options[0].size} to ${data.options[data.options.length - 1].size}, from $${from} CAD. Ships across North America.`;

const schemaImage = await getImage({ src: data.image, width: 1200, format: 'jpeg', quality: 80 });

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `${data.title} · Fine Art Astrophotography Print`,
  description: data.tagline,
  image: new URL(schemaImage.src, Astro.site).href,
  brand: { '@type': 'Brand', name: 'Abdur Astro' },
  category: 'Fine art print',
  offers: data.options.map((option) => ({
    '@type': 'Offer',
    name: `${option.size} · ${option.paper}`,
    price: option.price.toFixed(2),
    priceCurrency: 'CAD',
    availability: 'https://schema.org/InStock',
    itemCondition: 'https://schema.org/NewCondition',
    url: canonical,
    areaServed: ['CA', 'US'],
  })),
};
---

<Base
  title={`${data.title} Print`}
  description={description}
  ogImage={data.image}
  ogImageAlt={data.alt}
  schema={[productSchema]}
>
  <article class="mx-auto w-full max-w-7xl px-5 pt-14 sm:px-8 sm:pt-20">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,7fr)_minmax(22rem,5fr)] lg:gap-16">
      {/* Matted preview */}
      <div class="lg:sticky lg:top-8 lg:self-start">
        <div class="border hairline bg-surface p-4 sm:p-5">
          <Image
            src={data.closeupImage ?? data.image}
            alt={data.alt}
            widths={[640, 1080, 1600, 2200]}
            sizes="(min-width: 1024px) 55vw, 100vw"
            quality={80}
            loading="eager"
            fetchpriority="high"
            class="w-full object-contain"
          />
        </div>
        {
          photo && (
            <p class="mt-3 font-mono text-[0.6875rem] uppercase [letter-spacing:var(--tracking-log)] text-faint">
              {photo.data.target}
              {photo.data.captured && ` · ${photo.data.captured}`} ·{' '}
              <a href={`/gallery/${photo.id}`} class="link-quiet normal-case">
                View the observation log →
              </a>
            </p>
          )
        }
      </div>

      <div>
        <p class="eyebrow">Fine art print</p>
        <h1 class="mt-3 font-display text-4xl sm:text-5xl">{data.title}</h1>
        <p class="mt-4 text-faint">{data.tagline}</p>
        {/* The price belongs above the fold, and the edition drops to faint so the
            title is not sandwiched between two identical dust-orange labels. */}
        <div class="mt-5 flex flex-wrap items-baseline gap-x-4 gap-y-1">
          <p class="font-display text-2xl tabular-nums text-star">From ${from} CAD</p>
          <p class="font-mono text-[0.6875rem] uppercase [letter-spacing:var(--tracking-log)] text-faint">
            {data.edition}
          </p>
        </div>

        <div class="reveal mt-8 max-w-prose text-sm leading-relaxed text-star/85 [&_p]:mb-4 [&_p:last-child]:mb-0">
          <Content />
        </div>

        {/* Price ledger — one Stripe Payment Link per size + paper */}
        <section class="mt-10 border hairline bg-surface" aria-labelledby="options-heading">
          <header
            class="flex items-baseline justify-between border-b hairline px-5 py-3 font-mono text-[0.6875rem] uppercase [letter-spacing:var(--tracking-log)]"
          >
            <h2 id="options-heading" class="text-faint">Sizes &amp; papers</h2>
            <span class="text-dust">CAD</span>
          </header>
          <div class="px-5 py-2">
            {
              sizes.map(({ size, papers }, groupIndex) => (
                <div class:list={['py-4', groupIndex > 0 && 'border-t hairline']}>
                  <h3 class="font-mono text-sm text-star">{size}</h3>
                  {/* The price carries each row and Buy stays an outline button:
                      six solid Hα blocks read as one red ladder, which left the
                      page with no single loudest action. */}
                  <ul class="mt-3 space-y-4">
                    {papers.map((option) => (
                      <li class="flex items-baseline gap-3 font-mono text-[0.8125rem]">
                        <span class="text-faint">{option.paper}</span>
                        <span class="log-leader" aria-hidden="true" />
                        <span class="text-[0.9375rem] tabular-nums text-star">${option.price}</span>
                        <a
                          href={option.stripeLink}
                          class="btn btn-xs shrink-0"
                          data-stripe-placeholder
                          aria-label={`Buy ${data.title} ${option.size} on ${option.paper} for $${option.price} CAD`}
                        >
                          Buy
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </section>

        <div class="mt-6 space-y-2 text-xs leading-relaxed text-faint">
          <p>
            Archival pigment giclée · 100% cotton papers · signed
            {data.edition.toLowerCase().includes('limited') && ' and numbered'} · certificate of
            authenticity included.
          </p>
          <p>
            Ships across North America in a rigid tube. Turnaround currently 7–10 business days.
            Shipping and taxes calculated at Stripe checkout.{' '}
            <a href="/contact?topic=prints" class="link-quiet">Questions?</a>
          </p>
        </div>
      </div>
    </div>
  </article>
</Base>
