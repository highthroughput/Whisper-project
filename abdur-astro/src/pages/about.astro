---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import portrait from '../assets/photos/portrait.jpg';

// Affiliate referral suffix, defined once so the inventory links and the
// retailer list below can never drift apart. Verified against live product
// pages: the param survives redirects and fires Refersion's click endpoint.
const HPS_REF = 'rfsn=7861335.596f7c';
/** High Point Scientific product link carrying the referral. Slugs have no
    query string of their own, so '?' is always the right joiner here. */
const hps = (slug: string) => `https://www.highpointscientific.com/${slug}?${HPS_REF}`;

const gear = [
  {
    group: 'Optics',
    items: [
      ['Obsession 18″ f/4.5', 'truss Dobsonian · visual light bucket'],
      ['Celestron EdgeHD 11″', 'f/10 SCT · deep-sky imaging', hps('celestron-edge-hd-11-f-10-aplanatic-sct-ota-with-edge-hd-optics-91050-xlt')],
      ['Celestron EdgeHD 8″', 'f/10 SCT · deep-sky imaging', hps('celestron-edgehd-8-ota-8-quot-f-10-aplanatic-sct-ota-cge-dovetail-91030-xlt')],
      ['Askar FRA300 Quintuplet', 'apo refractor · widefield imaging', hps('askar-60-mm-f5-quintuplet-flat-field-astrograph-fra300pro')],
      ['SVBONY SV545 Petzval', 'apo refractor · widefield imaging'],
      ['Seestar S30 Pro', 'smart compact telescope · grab-and-go', hps('zwo-seestar-s30-pro-smart-telescope')],
    ],
  },
  {
    group: 'Camera',
    items: [
      ['ZWO ASI294MM Pro', 'cooled mono · Four Thirds', hps('zwo-asi294mm-pro-monochrome-cooled-camera-asi294mm-p')],
      ['Sony IMX410', 'full-frame CMOS sensor'],
      ['ZWO ASI2600MC Duo', 'cooled colour · built-in guide camera', hps('zwo-asi2600mc-duo-built-in-dual-sensor-astronomy-camera')],
    ],
  },
  {
    group: 'Mount',
    items: [
      ['iOptron CEM70', 'center-balanced equatorial mount', hps('ioptron-cem70-center-balanced-equatorial-mount-c70a')],
      // HPS carries no original HAE69, only the C/CEC/EC revisions, so this
      // points at the current base model while the row names the real mount.
      ['iOptron HAE69', 'harmonic drive equatorial mount', hps('ioptron-hae69c-az-eq-mount')],
      ['ZWO AM3', 'harmonic drive · portable', hps('zwo-am3-harmonic-drive-equatorial-mount-am3n-2025')],
    ],
  },
  {
    group: 'Filters',
    items: [
      ['Astronomik LRGB', '31 mm round · broadband colour set', hps('astronomik-lrgb-filter-set-31-mm-round-lrgb-31')],
      ['Astronomik Ha 6 nm MaxFR', '31 mm round · hydrogen-alpha', hps('astronomik-h-alpha-6-nm-ccd-maxfr-round-mounted-31mm-filter-ha6-maxfr-31')],
      ['Astronomik OIII 6 nm MaxFR', '31 mm round · oxygen-III', hps('astronomik-maxfr-oiii-6-nm-ccd-round-31mm-filter-asf-oiii6-maxfr-31')],
      ['Astronomik SII 6 nm MaxFR', '31 mm round · sulphur-II', hps('astronomik-maxfr-sii-6-nm-ccd-round-mounted-31mm-filter-sii6-maxfr-31')],
      ['Various duo-band filters', 'narrowband imaging under light pollution'],
    ],
  },
  {
    group: 'Control & processing',
    items: [
      ['N.I.N.A. + PHD2', 'acquisition & guiding automation'],
      ['PixInsight', 'calibration through final grade'],
      ['Siril', 'open-source calibration & stacking'],
    ],
  },
];

// The retailer links used across every gear-review video on the channel.
const retailers = [
  { name: 'Agena Astro', url: 'https://agenaastro.com/?rfsn=7861342.502056', note: 'Eyepieces, mounts & accessories' },
  { name: 'High Point Scientific', url: 'https://www.highpointscientific.com/?rfsn=7861335.596f7c', note: 'Telescopes & astro cameras' },
  { name: 'ZWO', url: 'https://www.zwoastro.com/?ref=abdurastro', note: 'Cameras, filters & focusers' },
  { name: 'All Star Telescope', url: 'https://all-startelescope.com/?sca_ref=6403255.SHIEyEffKU', note: 'Telescopes & smart scopes' },
  { name: 'Dwarflab', url: 'https://dwarflab.com?aff=132', note: 'Smart telescopes' },
  { name: 'MoveShootMove', url: 'https://www.moveshootmove.com?aff=354', note: 'Portable star trackers' },
];
---

<Base
  title="Alberta Astrophotographer"
  description="Abdur is an astrophotographer in Southern Alberta, Canada, photographing galaxies and nebulae from backyard and dark-sky sites, and teaching astrophotography through tutorials, talks, and star parties."
  ogImage={portrait}
  ogImageAlt="Abdur standing beside his Celestron EdgeHD and refractor telescopes on tracking mounts in a field."
>
  <section class="mx-auto w-full max-w-7xl px-5 pt-14 sm:px-8 sm:pt-20">
    <p class="eyebrow">The observer</p>
    <h1 class="mt-3 font-display text-4xl sm:text-5xl">About Abdur</h1>

    <div class="mt-10 grid gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
      <div>
        <div class="border hairline bg-surface p-4 sm:p-5">
          <Image
            src={portrait}
            alt="Abdur standing in a field beside his Celestron EdgeHD telescope on an orange-railed mount and a second refractor on a tracking mount, under a clear blue sky."
            widths={[420, 640, 960, 1280]}
            sizes="(min-width: 1024px) 40vw, 92vw"
            class="aspect-[4/5] w-full object-cover"
            loading="eager"
            quality={80}
          />
        </div>
        <p class="mt-3 font-mono text-[0.6875rem] uppercase [letter-spacing:var(--tracking-log)] text-faint">
          The observer &amp; the rig · Southern Alberta
        </p>
      </div>

      <div>
        {/* PLACEHOLDER COPY — replace with Abdur's real bio (see README "Replace before launch"). */}
        <div class="max-w-prose space-y-5 leading-relaxed text-star/85">
          <p>
            Abdur is an astrophotographer working from Southern Alberta, where the prairie
            meets some of the darkest accessible skies in Canada. His subjects are deep-sky
            objects: galaxies tens of millions of light-years out, and the nebulae where
            stars are born and die, photographed over dozens of hours per target from a
            backyard observatory and from Bortle 2 sites in the foothills.
          </p>
          <p>
            The work sits at the intersection of patience and precision: months of planning
            around moon phases and Alberta weather, nights of automated capture at −30 °C,
            and long days rendering faint signal into photographs that hold up on a gallery
            wall. Every image in the archive carries its full observation log, because in
            this craft the data is part of the picture.
          </p>
          <p>
            Off the pier, Abdur teaches one-on-one astrophotography tutorials online across
            Canada and in person around Southern Alberta, consults on equipment and remote
            observatory builds, rents out telescopes and mounts to observers not ready to buy,
            speaks at astronomy events, and hosts private star parties under the skies that made
            all of this possible.
          </p>
        </div>

        <div class="mt-8 flex flex-wrap gap-4">
          <a href="/services" class="btn">Work with Abdur</a>
          <a href="/contact" class="btn btn-solid">Say hello</a>
        </div>
      </div>
    </div>

    {/* The two log panels run full width: in the two-column grid they left a
        tall void under the portrait and were squeezed into the narrower track. */}
    <div class="mt-16 grid items-start gap-6 lg:grid-cols-2">
      {/* Gear list, set as a field inventory — same log grammar as the archive */}
      <section class="reveal border hairline bg-surface" aria-labelledby="gear-heading">
        <header
          class="flex items-baseline justify-between border-b hairline px-5 py-3 font-mono text-[0.6875rem] uppercase [letter-spacing:var(--tracking-log)]"
        >
          <h2 id="gear-heading" class="text-faint">Field inventory</h2>
          <span class="text-dust">Current rig</span>
        </header>
        {/* Padding sits on each group, not the <dl>, so every rule in the panel
            runs the full width instead of some full-bleed and some inset. */}
        <dl class="py-3 font-mono text-[0.8125rem]">
          {
            gear.map(({ group, items }, i) => (
              <div class:list={['px-5 py-3', i > 0 && 'border-t hairline']}>
                <dt class="text-[0.6875rem] uppercase [letter-spacing:var(--tracking-log)] text-faint">
                  {group}
                </dt>
                {items.map(([name, note, url]) => (
                  <dd class="mt-2 flex flex-col sm:flex-row sm:items-baseline">
                    {/* A dotted underline marks which rows are links: half the
                        inventory is not, and text-star alone made them identical. */}
                    {url ? (
                      <a
                        href={url}
                        target="_blank"
                        rel="sponsored nofollow noopener noreferrer"
                        class="text-star underline decoration-star/25 decoration-dotted underline-offset-4 transition-colors duration-150 hover:text-dust-bright hover:decoration-dust-bright"
                      >
                        {name}
                      </a>
                    ) : (
                      <span class="text-star">{name}</span>
                    )}
                    <span class="log-leader hidden sm:block" aria-hidden="true" />
                    <span class="text-faint sm:text-right">{note}</span>
                  </dd>
                ))}
              </div>
            ))
          }
        </dl>
        <p class="border-t hairline px-5 py-3 text-xs leading-relaxed text-faint">
          Linked items go to High Point Scientific through an affiliate link. Using one costs
          nothing extra and helps fund the next review. Items with no link are bought direct or
          are free software.
        </p>
      </section>

      {/* Retailer links from the YouTube gear reviews, disclosed plainly rather than run as a shop banner */}
      <section class="reveal border hairline bg-surface" aria-labelledby="partners-heading">
        <header
          class="flex items-baseline justify-between border-b hairline px-5 py-3 font-mono text-[0.6875rem] uppercase [letter-spacing:var(--tracking-log)]"
        >
          <h2 id="partners-heading" class="text-faint">Where I buy</h2>
          <span class="text-dust">Retailers</span>
        </header>
        <dl class="px-5 py-3 font-mono text-[0.8125rem]">
          <div class="py-3">
            {
              retailers.map(({ name, url, note }) => (
                <dd class="mt-2 flex flex-col sm:flex-row sm:items-baseline">
                  <a href={url} target="_blank" rel="sponsored noopener noreferrer" class="link-quiet text-star">
                    {name}
                  </a>
                  <span class="log-leader hidden sm:block" aria-hidden="true" />
                  <span class="text-faint sm:text-right">{note}</span>
                </dd>
              ))
            }
          </div>
        </dl>
        <p class="border-t hairline px-5 py-3 text-xs leading-relaxed text-faint">
          The retailers used to buy and test gear covered on the YouTube channel. Some of these
          are affiliate links: using them costs nothing extra and helps fund the next review.
        </p>
      </section>
    </div>
  </section>
</Base>
