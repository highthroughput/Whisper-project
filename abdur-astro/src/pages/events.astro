---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';

const startOfToday = new Date();
startOfToday.setHours(0, 0, 0, 0);

const upcoming = (await getCollection('events'))
  .filter((event) => event.data.date >= startOfToday)
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

const entries = await Promise.all(
  upcoming.map(async (event) => ({ event, Content: (await render(event)).Content })),
);

const hasHosted = upcoming.some((event) => event.data.kind === 'hosted');

const monthDay = (date: Date) =>
  date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }).toUpperCase();
---

<Base
  title="Events Calendar"
  description="Upcoming star parties near Southern Alberta, plus meteor showers, solstices, and other astronomical events worth planning a night around."
>
  <section class="mx-auto w-full max-w-5xl px-5 pt-14 sm:px-8 sm:pt-20">
    <p class="eyebrow">What's coming up</p>
    <h1 class="mt-3 font-display text-4xl sm:text-5xl">Events</h1>
    <p class="mt-6 max-w-2xl text-faint">
      Star parties and talks happening in and around Southern Alberta, alongside the meteor
      showers, solstices, and other sky events worth planning a night around.
    </p>

    {
      !hasHosted && (
        <div class="reveal mt-8 max-w-2xl border border-l-2 hairline border-l-dust bg-surface p-5">
          <p class="eyebrow text-faint">Calendar status</p>
          <p class="mt-2 text-sm text-star/85">
            No public star parties on the calendar right now.{' '}
            <a href="/contact?topic=starparty" class="link-quiet">
              Ask about booking a private one →
            </a>
          </p>
        </div>
      )
    }

    <ul class="mt-12">
      {
        entries.length === 0 ? (
          <p class="text-faint">Nothing on the calendar yet. Check back soon.</p>
        ) : (
          entries.map(({ event, Content }) => (
            <li id={event.id} class="reveal border-b hairline first:border-t">
              <article class="grid gap-x-8 gap-y-3 py-10 sm:grid-cols-[6.5rem_minmax(0,1fr)_9rem] sm:items-start">
                {/* On phones the date is one inline row; stacking it put four
                    micro-labels above the title before any real content. */}
                <div class="flex items-baseline gap-2 font-mono sm:block">
                  <p class="text-2xl tabular-nums text-star">{monthDay(event.data.date)}</p>
                  <p class="text-[0.6875rem] uppercase [letter-spacing:var(--tracking-log)] text-faint sm:mt-1">
                    {event.data.date.getFullYear()}
                  </p>
                </div>

                <div>
                  <p
                    class:list={[
                      'font-mono text-[0.6875rem] uppercase [letter-spacing:var(--tracking-log)]',
                      event.data.kind === 'hosted' ? 'text-ha' : 'text-dust',
                    ]}
                  >
                    {event.data.kind === 'hosted' ? 'Hosted' : 'Sky event'}
                  </p>
                  <h2 class="mt-1.5 font-display text-2xl">{event.data.title}</h2>
                  {/* The timing token stays in the log register; the viewing note
                      is a sentence and reads as one, not as a tracked caps banner. */}
                  <p class="mt-1.5 font-mono text-[0.6875rem] uppercase [letter-spacing:var(--tracking-log)] text-faint">
                    {event.data.when}
                  </p>
                  {event.data.location && (
                    <p class="mt-1 text-sm text-faint">{event.data.location}</p>
                  )}
                  <div class="reveal mt-3 max-w-prose text-sm leading-relaxed text-star/85 [&_p]:mb-3 [&_p:last-child]:mb-0">
                    <Content />
                  </div>
                </div>

                <div class="sm:self-end">
                  {
                    event.data.kind === 'hosted' ? (
                      <a
                        href={event.data.rsvpLink ?? '/contact?topic=starparty'}
                        class="btn btn-solid btn-sm"
                      >
                        RSVP →
                      </a>
                    ) : (
                      event.data.infoUrl && (
                        <a
                          href={event.data.infoUrl}
                          class="btn btn-sm"
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          Learn more →
                        </a>
                      )
                    )
                  }
                </div>
              </article>
            </li>
          ))
        )
      }
    </ul>
  </section>
</Base>
